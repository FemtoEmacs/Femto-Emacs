;; Portable support for compiling Schemer itself. No editor/old VM calls.
(define (table) (make-eq-hashtable))
(define (get t key . default) (hashtable-ref t key (if (null? default) #f (car default))))
(define (put! t key value) (hashtable-set! t key value) value)
(define (ash n count)
  (if (>= count 0) (* n (expt 2 count))
      (let* ((d (expt 2 (- count))) (q (quotient n d)))
        (if (and (< n 0) (not (= (remainder n d) 0))) (- q 1) q))))
(define (positive-bits n)
  (let loop ((n n) (count 0)) (if (= n 0) count (loop (quotient n 2) (+ count 1)))))
(define (logand a b)
  (cond ((< b 0) (if (< a 0) (- -1 (logior (- -1 a) (- -1 b))) (logand b a)))
        ((< a 0) (logand (modulo a (expt 2 (positive-bits b))) b))
        (else (let loop ((a a) (b b) (bit 1) (result 0))
                (if (or (= a 0) (= b 0)) result
                    (loop (quotient a 2) (quotient b 2) (* bit 2)
                          (+ result (if (and (odd? a) (odd? b)) bit 0))))))))
(define (logior a b)
  (cond ((< a 0) (- -1 (logand (- -1 a) (- -1 b))))
        ((< b 0) (logior b a))
        (else (let loop ((a a) (b b) (bit 1) (result 0))
                (if (and (= a 0) (= b 0)) result
                    (loop (quotient a 2) (quotient b 2) (* bit 2)
                          (+ result (if (or (odd? a) (odd? b)) bit 0))))))))
