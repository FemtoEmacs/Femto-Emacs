(define (%case-map runs n)
  (let loop ((lo 0) (hi (quotient (vector-length runs) 4)))
    (if (>= lo hi)
        n
        (let* ((m (quotient (+ lo hi) 2)) (k (* m 4)) (first (vector-ref runs k)))
          (cond ((< n first) (loop lo m))
                ((> n (vector-ref runs (+ k 1))) (loop (+ m 1) hi))
                ((= 0 (remainder (- n first) (vector-ref runs (+ k 2)))) (+ n (vector-ref runs (+ k 3))))
                (else n))))))
(define (char-upcase c)
  (let ((n (char->integer c)))
    (cond ((< n 97) c)
          ((<= n 122) (integer->char (- n 32)))
          ((< n 128) c)
          (else (integer->char (%case-map %upcase-runs n))))))
(define (char-downcase c)
  (let ((n (char->integer c)))
    (cond ((< n 65) c)
          ((<= n 90) (integer->char (+ n 32)))
          ((< n 128) c)
          (else (integer->char (%case-map %downcase-runs n))))))

;;; Strings ------------------------------------------------------------------

(define (make-string n . c) (%make-string n (if (null? c) #\space (car c))))
(define (string . cs) (list->string cs))
(define (list->string l)
  (let ((s (%make-string (length l) #\space)))
    (let loop ((i 0) (l l)) (if (pair? l) (begin (string-set! s i (car l)) (loop (+ i 1) (cdr l)))))
    s))
(define (string->list s)
  (let loop ((i (- (string-length s) 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (string-ref s i) acc)))))
;;; the copies are array.copy instructions
(define (substring s start . end)
  (let* ((e (if (null? end) (string-length s) (car end))) (r (%make-string (- e start) #\space)))
    (%string-copy! r 0 s start (- e start))
    r))
(define (string-copy s . range)
  (let ((start (if (null? range) 0 (car range))))
    (substring s start (if (or (null? range) (null? (cdr range))) (string-length s) (cadr range)))))
(define (string-copy! to at from . range)
  (let* ((start (if (null? range) 0 (car range)))
         (end (if (or (null? range) (null? (cdr range))) (string-length from) (cadr range))))
    (%string-copy! to at from start (- end start))))
(define (string-append . ss)
  (let* ((n (let loop ((l ss) (n 0)) (if (null? l) n (loop (cdr l) (+ n (string-length (car l)))))))
         (r (%make-string n #\space)))
    (let loop ((l ss) (k 0))
      (if (pair? l)
          (let ((s (car l)))
            (%string-copy! r k s 0 (string-length s))
            (loop (cdr l) (+ k (string-length s))))))
    r))
(define (string=? a b)
  (and (= (string-length a) (string-length b))
       (let loop ((i 0))
         (or (= i (string-length a))
             (and (char=? (string-ref a i) (string-ref b i)) (loop (+ i 1)))))))
(define (string<? a b)
  (let loop ((i 0))
    (cond ((= i (string-length a)) (< i (string-length b)))
          ((= i (string-length b)) #f)
          ((char<? (string-ref a i) (string-ref b i)) #t)
          ((char<? (string-ref b i) (string-ref a i)) #f)
          (else (loop (+ i 1))))))
(define (symbol->string s) (string-copy (%symbol-name s)))
(define (string->symbol s) (%intern! (%make-symbol (string-copy s))))
;;; The symbols known, by the hash of their names: a vector of lists.  The
;;; program's constant symbols are interned by init, before this file's
;;; definitions run (an undefined global holds '()): the vector is made at
;;; the first symbol, and its definition below keeps it.
(define (%symbol-buckets)
  (if (vector? %symbol-table) %symbol-table
      (begin (set! %symbol-table (%make-vector 4096 (quote ()))) %symbol-table)))
(define (%intern! sym)
  ;; the symbol of the same name already known, or SYM, now known
  (let* ((name (%symbol-name sym)) (b (%symbol-buckets))
         (i (remainder (%string-hash name) (vector-length b))) (bucket (vector-ref b i)))
    (let loop ((l bucket))
      (cond ((null? l) (vector-set! b i (cons sym bucket)) sym)
            ((%name=? (%symbol-name (car l)) name) (car l))
            (else (loop (cdr l)))))))
(define %symbol-table (%symbol-buckets))
(define (%name=? a b)
  (and (= (string-length a) (string-length b))
       (let loop ((i 0))
         (or (= i (string-length a))
             (and (= (char->integer (string-ref a i)) (char->integer (string-ref b i))) (loop (+ i 1)))))))
(define *gensym-count* 0)
(define (gensym) (set! *gensym-count* (+ *gensym-count* 1))
  (%make-symbol (string-append "g" (%fixnum->string *gensym-count*))))

;;; Vectors ------------------------------------------------------------------

(define (make-vector n . fill) (%make-vector n (if (null? fill) 0 (car fill))))
(define (vector . xs) (list->vector xs))
(define (list->vector l)
  (let ((v (%make-vector (length l) 0)))
    (let loop ((i 0) (l l)) (if (pair? l) (begin (vector-set! v i (car l)) (loop (+ i 1) (cdr l)))))
    v))
(define (vector->list v)
  (let loop ((i (- (vector-length v) 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (vector-ref v i) acc)))))
(define (vector-copy v . range)
  (let* ((start (if (null? range) 0 (car range)))
         (end (if (or (null? range) (null? (cdr range))) (vector-length v) (cadr range)))
         (r (%make-vector (- end start) 0)))
    (%vector-copy! r 0 v start (- end start))
    r))
(define (vector-copy! to at from . range)
  (let* ((start (if (null? range) 0 (car range)))
         (end (if (or (null? range) (null? (cdr range))) (vector-length from) (cadr range))))
    (%vector-copy! to at from start (- end start))))
(define (vector-append . vs)
  (let* ((n (let loop ((l vs) (n 0)) (if (null? l) n (loop (cdr l) (+ n (vector-length (car l)))))))
         (r (%make-vector n 0)))
    (let loop ((l vs) (k 0))
      (if (pair? l)
          (begin (%vector-copy! r k (car l) 0 (vector-length (car l)))
                 (loop (cdr l) (+ k (vector-length (car l)))))))
    r))
(define (vector-fill! v x)
  (let loop ((i 0)) (if (< i (vector-length v)) (begin (vector-set! v i x) (loop (+ i 1))))))
(define (vector-map f v . vs) (list->vector (apply map f (vector->list v) (map vector->list vs))))
(define (vector-for-each f v . vs) (apply for-each f (vector->list v) (map vector->list vs)))

;;; Ports ------------------------------------------------------------------
;;; A port is a record with fields:
;;;   (console)              the page's output
;;;   (output string count)  an output string port (the string grows)
;;;   (input string pos)     an input string port
;;; %out is the output port of a string port being written, or #f.

(define %port-tag (cons (quote port) (quote ())))   ; cons: ready before the library
(define %console (%make-record %port-tag (vector (quote console))))
(define (%pf p i) (vector-ref (%record-fields p) i))
(define (%pf-set! p i v) (vector-set! (%record-fields p) i v))
(define %out #f)
(define (port? x) (%record-of? x %port-tag))
(define (%port-kind p) (%pf p 0))
(define (input-port? x) (and (port? x) (eq? (%port-kind x) (quote input))))
(define (output-port? x) (and (port? x) (not (eq? (%port-kind x) (quote input)))))
(define (textual-port? x) (port? x))
(define (input-port-open? p) (input-port? p))
(define (output-port-open? p) (output-port? p))
(define (current-output-port) (or %out %console))
(define (current-error-port) %console)
(define %stdin #f)   ; the page has no input: an empty string port, made when asked for
(define (current-input-port) (or %stdin (begin (set! %stdin (open-input-string "")) %stdin)))
(define (flush-output-port . port)
  ;; a file port: its text so far goes to the file
  (let ((p (if (null? port) (current-output-port) (car port))))
    (if (and (eq? (%port-kind p) (quote output)) (%pf p 3))
        (%file 1 (%pf p 3) (get-output-string p))))
  (%unspecified))

;;; Files: the host keeps them (the page: in memory; node: on disk)
(define (open-input-file name)
  (let ((text (%file 0 name #f)))
    (if (string? text) (open-input-string text)
        (raise (%make-record %error-type (vector "cannot open the file" (list name) (quote file)))))))
(define (open-output-file name . options)
  (let ((p (%make-record %port-tag (vector (quote output) (%make-string 32 #\space) 0 name))))
    (%file 1 name "")
    p))
(define (file-exists? name) (eqv? (%file 2 name #f) 1))
(define (delete-file name) (%file 3 name #f) (%unspecified))
(define (call-with-port port proc)
  (call-with-values (lambda () (proc port))
    (lambda vals (close-port port) (apply values vals))))
(define (call-with-input-file name proc) (call-with-port (open-input-file name) proc))
(define (call-with-output-file name proc) (call-with-port (open-output-file name) proc))
(define (with-input-from-file name thunk)
  (let ((saved %stdin) (p (open-input-file name)))
    (dynamic-wind (lambda () (set! %stdin p)) thunk (lambda () (set! %stdin saved)))))
(define (with-output-to-file name thunk)
  (let ((p (open-output-file name)))
    (let ((v (%with-port (list p) thunk)))
      (close-port p)
      v)))
(define (close-port p) (if (output-port? p) (close-output-port p)) (%unspecified))
(define (close-input-port p) (%unspecified))
(define (close-output-port p) (flush-output-port p) (%unspecified))
(define (eof-object) (%eof))
(define (eof-object? x) (eq? x (%eof)))

(define (open-output-string) (%make-record %port-tag (vector (quote output) (%make-string 32 #\space) 0 #f)))
(define (get-output-string p) (substring (%pf p 1) 0 (%pf p 2)))
(define (%port-put! p c)
  (let ((s (%pf p 1)) (n (%pf p 2)))
    (when (= n (string-length s))
      (let ((bigger (%make-string (* 2 n) #\space)))
        (%string-copy! bigger 0 s 0 n)
        (%pf-set! p 1 bigger)))
    (string-set! (%pf p 1) n c)
    (%pf-set! p 2 (+ n 1))))
(define (%port-put-string! p s start end)
  (let* ((buf (%pf p 1)) (n (%pf p 2)) (k (- end start)))
    (when (> (+ n k) (string-length buf))
      (let ((bigger (%make-string (* 2 (+ n k)) #\space)))
        (%string-copy! bigger 0 buf 0 n)
        (%pf-set! p 1 bigger)))
    (%string-copy! (%pf p 1) n s start k)
    (%pf-set! p 2 (+ n k))))
(define (%emit c) (if %out (%port-put! %out c) (%write-char c)))
;;; (%with-port port thunk): THUNK's output goes to PORT
(define (%with-port port thunk)
  ;; no port: the current one; else PORT, until THUNK is left (even by an escape)
  (if (null? port)
      (thunk)
      (let ((saved %out) (new (if (eq? (car port) %console) #f (car port))))
        (if (eq? new saved)
            (thunk)
            (begin (set! %out new)
                   (%protect thunk (lambda () (set! %out saved))))))))
(define (call-with-output-string proc)
  (let ((p (open-output-string))) (proc p) (get-output-string p)))
(define (with-output-to-string thunk)
  (let ((p (open-output-string))) (%with-port (list p) thunk) (get-output-string p)))

(define (open-input-string s) (%make-record %port-tag (vector (quote input) s 0)))
(define (%in port) (if (null? port) (current-input-port) (car port)))
(define (read-char . port) (%next (if (null? port) (current-input-port) (car port))))
(define (peek-char . port) (%peek (if (null? port) (current-input-port) (car port))))
(define (char-ready? . port) #t)
(define (read-line . port)
  (let* ((p (%in port)) (s (%pf p 1)) (start (%pf p 2)) (n (string-length s)))
    (if (>= start n) (%eof)
        (let loop ((i start))
          (cond ((= i n) (%pf-set! p 2 n) (substring s start n))
                ((char=? (string-ref s i) #\newline) (%pf-set! p 2 (+ i 1)) (substring s start i))
                (else (loop (+ i 1))))))))
(define (read-string k . port)
  (let* ((p (%in port)) (s (%pf p 1)) (start (%pf p 2))
         (end (min (string-length s) (+ start k))))
    (if (and (>= start (string-length s)) (> k 0)) (%eof)
        (begin (%pf-set! p 2 end) (substring s start end)))))

;;; Reading ------------------------------------------------------------------
;;; (read [port]) reads a datum from an input string port.

(define (read . port) (%read-datum (%in port) #f))

(define (%delimiter? c)
  (or (eof-object? c) (char-whitespace? c) (memv c '(#\( #\) #\[ #\] #\" #\; #\'  #\` #\,))))

(define (%skip-space p)
  (let ((c (%peek p)))
    (cond ((eof-object? c) c)
          ((char-whitespace? c) (%next p) (%skip-space p))
          ((char=? c #\;) (let line () (let ((c (%next p))) (if (not (or (eof-object? c) (char=? c #\newline))) (line))))
                          (%skip-space p))
          ((char=? c #\#)
           (let ((s (%pf p 1)) (i (%pf p 2)))
             (cond ((and (< (+ i 1) (string-length s)) (char=? (string-ref s (+ i 1)) #\|))
                    (%next p) (%next p)
                    (let block ((depth 1))
                      (let ((c (%next p)))
                        (cond ((eof-object? c) (error "read: unterminated #| comment"))
                              ((and (char=? c #\|) (eqv? (%peek p) #\#)) (%next p)
                               (if (> depth 1) (block (- depth 1))))
                              ((and (char=? c #\#) (eqv? (%peek p) #\|)) (%next p) (block (+ depth 1)))
                              (else (block depth)))))
                    (%skip-space p))
                   ((and (< (+ i 1) (string-length s)) (char=? (string-ref s (+ i 1)) #\;))
                    (%next p) (%next p) (%read-datum p #f) (%skip-space p))
                   ((and (< (+ i 1) (string-length s)) (char=? (string-ref s (+ i 1)) #\!))
                    ;; #!fold-case and the like: skipped
                    (%next p) (%next p) (%read-token p) (%skip-space p))
                   (else c))))
          (else c))))

(define (%read-token p)
  (let loop ((cs '()))
    (let ((c (%peek p)))
      (cond ((%delimiter? c) (list->string (reverse cs)))
            ((and (char=? c #\\) (begin (%next p) (memv (%peek p) '(#\x #\X))))
             (%next p)                      ; \x3bb; in an identifier
             (loop (cons (%read-escape-hex p) cs)))
            ((char=? c #\\) (error "read: \\ in an identifier"))
            (else (%next p) (loop (cons c cs)))))))
(define (%read-escape-hex p)
  (let hex ((n 0))
    (let ((d (%next p)))
      (cond ((eof-object? d) (error "read: unterminated \\x escape"))
            ((char=? d #\;) (integer->char n))
            (else (hex (+ (* n 16) (%hex-digit d))))))))
;;; fast read-char and peek-char of a string port
(define (%next p)
  (let* ((f (%record-fields p)) (s (vector-ref f 1)) (i (vector-ref f 2)))
    (if (< i (string-length s)) (begin (vector-set! f 2 (+ i 1)) (string-ref s i)) (%eof))))
(define (%peek p)
  (let* ((f (%record-fields p)) (s (vector-ref f 1)) (i (vector-ref f 2)))
    (if (< i (string-length s)) (string-ref s i) (%eof))))

;;; CLOSE: the closing character expected, for an error at a stray one
(define (%read-datum p close)
  (let ((c (%skip-space p)))
    (cond ((eof-object? c) c)
          ((or (char=? c #\() (char=? c #\[)) (%next p) (%read-list p (if (char=? c #\() #\) #\])))
          ((or (char=? c #\)) (char=? c #\])) (%next p) (error "read: unexpected" c))
          ((char=? c #\') (%next p) (list (quote quote) (%read-next p)))
          ((char=? c #\`) (%next p) (list (quote quasiquote) (%read-next p)))
          ((char=? c #\,) (%next p)
                          (if (eqv? (%peek p) #\@)
                              (begin (%next p) (list (quote unquote-splicing) (%read-next p)))
                              (list (quote unquote) (%read-next p))))
          ((char=? c #\") (%next p) (%read-string p))
          ((char=? c #\|) (%next p) (string->symbol (%read-until p #\|)))
          ((char=? c #\#) (%next p) (%read-hash p))
          (else (let ((tok (%read-token p)))
                  (cond ((string->number tok))
                        ((string=? tok ".") (error "read: unexpected ."))
                        (else (string->symbol tok))))))))
;;; a datum that must be there
(define (%read-next p)
  (let ((x (%read-datum p #f)))
    (if (eof-object? x) (error "read: a datum is missing at the end") x)))

(define (%read-list p close)
  (let loop ((acc '()))
    (let ((c (%skip-space p)))
      (cond ((eof-object? c) (error "read: a list is not closed"))
            ((or (char=? c #\)) (char=? c #\]))
             (%next p) (reverse acc))
            ((and (char=? c #\.) (let ((s (%pf p 1)) (i (%pf p 2)))
                                   (or (= (+ i 1) (string-length s)) (%delimiter? (string-ref s (+ i 1))))))
             (%next p)
             (let ((tail (%read-datum p #f)))
               (let ((c (%skip-space p)))
                 (if (and (char? c) (or (char=? c #\)) (char=? c #\])))
                     (begin (%next p) (append (reverse acc) tail))
                     (error "read: bad dotted list")))))
            (else (loop (cons (%read-datum p close) acc)))))))

(define (%read-until p end)
  (let loop ((cs '()))
    (let ((c (%next p)))
      (cond ((eof-object? c) (error "read: unterminated" end))
            ((char=? c end) (list->string (reverse cs)))
            ((char=? c #\\) (loop (cons (%read-escape p) cs)))
            (else (loop (cons c cs)))))))
(define (%read-string p) (%read-until p #\"))

(define (%read-escape p)
  (let ((c (%next p)))
    (case c
      ((#\n) #\newline) ((#\t) #\tab) ((#\r) (integer->char 13)) ((#\a) (integer->char 7))
      ((#\b) (integer->char 8)) ((#\0) (integer->char 0))
      ((#\x #\X) (let hex ((n 0))
                   (let ((d (%next p)))
                     (if (char=? d #\;) (integer->char n)
                         (hex (+ (* n 16) (%hex-digit d)))))))
      ((#\newline #\space #\tab)
       ;; a line continuation: the line's end and the next line's leading space vanish
       (let skip () (let ((d (%peek p))) (if (and (char? d) (char-whitespace? d)) (begin (%next p) (skip)))))
       (%read-escape-after-continuation p))
      (else c))))
(define (%read-escape-after-continuation p)
  (let ((c (%next p)))
    (if (char=? c #\\) (%read-escape p) c)))
(define (%hex-digit d)
  (let ((n (char->integer (char-downcase d))))
    (cond ((and (>= n 48) (<= n 57)) (- n 48)) ((and (>= n 97) (<= n 102)) (- n 87))
          (else (error "read: not a hexadecimal digit" d)))))

(define %char-names
  (list (cons "space" #\space) (cons "newline" #\newline) (cons "tab" #\tab)
        (cons "nul" (integer->char 0)) (cons "null" (integer->char 0)) (cons "alarm" (integer->char 7))
        (cons "backspace" (integer->char 8)) (cons "delete" (integer->char 127))
        (cons "escape" (integer->char 27)) (cons "altmode" (integer->char 27))
        (cons "return" (integer->char 13)) (cons "linefeed" #\newline)))

(define (%read-hash p)
  (let ((c (%peek p)))
    (cond ((eof-object? c) (error "read: # at the end"))
          ((char=? c #\() (%next p) (list->vector (%read-list p #\))))
          ;; #'x #`x #,x #,@x: syntax, quasisyntax, unsyntax, unsyntax-splicing
          ((char=? c #\') (%next p) (list (quote syntax) (%read-next p)))
          ((char=? c #\`) (%next p) (list (quote quasisyntax) (%read-next p)))
          ((char=? c #\,) (%next p)
           (if (eqv? (%peek p) #\@)
               (begin (%next p) (list (quote unsyntax-splicing) (%read-next p)))
               (list (quote unsyntax) (%read-next p))))
          ((char=? c #\\)
           (%next p)
           (let* ((first (%next p))
                  (rest (let name ((cs '()))   ; letters and digits: #\a#\b is two characters
                          (let ((c (%peek p)))
                            (if (and (char? c) (or (char-alphabetic? c) (char-numeric? c)))
                                (begin (%next p) (name (cons c cs)))
                                (list->string (reverse cs)))))))
             (cond ((eof-object? first) (error "read: #\\ at the end"))
                   ((string=? rest "") first)
                   ((assoc (string-append (string first) rest) %char-names) => cdr)
                   ((and (memv first '(#\x #\X)) (> (string-length rest) 0) (string->number rest 16))
                    (integer->char (string->number rest 16)))
                   (else (error "read: unknown character name" (string-append (string first) rest))))))
          (else
           (let* ((tok (%read-token p)) (low (string-downcase tok)))
             (cond ((member low '("t" "true")) #t)
                   ((member low '("f" "false")) #f)
                   ((and (string=? tok "u8") (eqv? (%peek p) #\())
                    (%next p) (apply bytevector (%read-list p #\))))
                   ((string->number (string-append "#" tok)))
                   (else (error "read: unknown syntax" (string-append "#" tok)))))))))

;;; Output ------------------------------------------------------------------

(define (write-char c . port)
  (cond ((null? port) (%emit c))
        ((eq? (%port-kind (car port)) (quote output)) (%port-put! (car port) c))
        (else (%write-char c))))
(define (newline . port) (if (null? port) (%emit #\newline) (write-char #\newline (car port))))
(define (write-string s . port)
  (let ((p (if (null? port) %out (car port))))
    (cond ((and p (eq? (%port-kind p) (quote output)))
           (let ((start (if (and (pair? port) (pair? (cdr port))) (cadr port) 0))
                 (end (if (and (pair? port) (pair? (cdr port)) (pair? (cddr port))) (caddr port) (string-length s))))
             (%port-put-string! p s start end)))
          ((pair? port) (%with-port port (lambda () (%put-string s))))
          (else (%put-string s)))))
(define (%put-string s)
  (if %out
      (%port-put-string! %out s 0 (string-length s))
      (let loop ((i 0)) (if (< i (string-length s)) (begin (%write-char (string-ref s i)) (loop (+ i 1)))))))
(define (display x . port) (%with-port port (lambda () (%print x #f))))
(define (write x . port) (%with-port port (lambda () (%print x #t))))
(define (write-shared x . port) (%with-port port (lambda () (%print x #t))))
(define (write-simple x . port) (%with-port port (lambda () (%print x #t))))
(define (%print x quote?)
  (cond ((or (fixnum? x) (%int? x)) (%put-string (%fixnum->string x)))
        ((flonum? x) (if %out (%put-string (%flonum->string x)) (%write-flonum x)))
        ((string? x) (if quote? (%write-quoted x) (%put-string x)))
        ((symbol? x) (if (and quote? (%needs-bars? (%symbol-name x)))
                         (begin (%emit #\|) (%put-string (%symbol-name x)) (%emit #\|))
                         (%put-string (%symbol-name x))))
        ((char? x) (if quote? (begin (%put-string "#\\") (%write-char-name x)) (%emit x)))
        ((null? x) (%put-string "()"))
        ((eq? x #t) (%put-string "#t"))
        ((eq? x #f) (%put-string "#f"))
        ((pair? x) (%print-list x quote?))
        ((port? x) (%put-string "#<port>"))
        ((bytevector? x) (%put-string "#u8") (%print-list (vector->list (%bytes x)) #f))
        ((error-object? x) (%put-string "#<error ") (write (error-object-message x)) (%put-string ">"))
        ((record? x)   ; as Chez: #[name field ...]
         (%put-string "#[") (%print (record-type-name (%record-tag x)) #f)
         (vector-for-each (lambda (v) (%emit #\space) (%print v quote?)) (%record-fields x))
         (%emit #\]))
        ((and (%record? x) (record-type-descriptor? (%record-tag x)))   ; opaque
         (%put-string "#<") (%print (record-type-name (%record-tag x)) #f) (%put-string ">"))
        ((record-type-descriptor? x) (%put-string "#<record type ") (%print (%rf x 0) #f) (%put-string ">"))
        ((%record? x) (%put-string "#<") (%print (car (%record-tag x)) #f) (%put-string ">"))
        ((vector? x) (%emit #\#) (%print-list (vector->list x) quote?))
        ((procedure? x) (%put-string "#<procedure>"))
        ((eq? x (%eof)) (%put-string "#<eof>"))
        (else (%put-string "#<unspecified>"))))
(define (%needs-bars? s)
  (or (= (string-length s) 0)
      (let loop ((i 0))
        (and (< i (string-length s))
             (or (memv (string-ref s i) '(#\space #\( #\) #\" #\; #\| #\' #\tab #\newline))
                 (loop (+ i 1)))))))
(define (%print-list l quote?)
  (%emit #\()
  (let loop ((l l) (first #t))
    (cond ((null? l) (%emit #\)))
          ((pair? l)
           (if (not first) (%emit #\space))
           (%print (car l) quote?)
           (loop (cdr l) #f))
          (else (%put-string " . ") (%print l quote?) (%emit #\))))))
(define (%write-quoted s)
  (%emit #\")
  (let loop ((i 0))
    (if (< i (string-length s))
        (let ((c (string-ref s i)))
          (cond ((char=? c #\") (%put-string "\\\""))
                ((char=? c #\\) (%put-string "\\\\"))
                ((char=? c #\newline) (%put-string "\\n"))
                ;; as Chez writes them
                ((char=? c #\tab) (%put-string "\\t"))
                ((char=? c (integer->char 13)) (%put-string "\\r"))
                ((< (char->integer c) 32)
                 (%put-string "\\x") (%put-string (number->string (char->integer c) 16)) (%emit #\;))
                (else (%emit c)))
          (loop (+ i 1)))))
  (%emit #\"))
(define (%write-char-name c)
  (cond ((char=? c #\space) (%put-string "space"))
        ((char=? c #\newline) (%put-string "newline"))
        (else (%emit c))))

;;; Time, promises -------------------------------------------------------------

(define (%time-it thunk)
  (let* ((t0 (%now)) (v (thunk)) (t1 (%now)))
    (%put-string "Elapsed time: ")
    (%print (/ (- t1 t0) 1000.0) #f)
    (%put-string " seconds")
    (newline)
    v))
(define (current-time) (/ (%now) 1000.0))
;;; A promise: a record of (done? value-or-thunk lazy?); a lazy one
;;; (delay-force) has a thunk giving a promise, whose value it takes
(define %promise-type (cons (quote promise) (quote ())))
(define (%make-promise thunk) (%make-record %promise-type (vector #f thunk #f)))
(define (%make-lazy-promise thunk) (%make-record %promise-type (vector #f thunk #t)))
(define (force p)
  (if (not (promise? p)) p
      (let ((f (%record-fields p)))
        (if (vector-ref f 0) (vector-ref f 1)
            (let ((v ((vector-ref f 1))))
              (cond ((vector-ref f 0) (vector-ref f 1))   ; forced meanwhile
                    ((vector-ref f 2) (let ((w (force v))) (vector-set! f 0 #t) (vector-set! f 1 w) w))
                    (else (vector-set! f 0 #t) (vector-set! f 1 v) v)))))))

;;; Globals by name, as in Chez: top-level-value, set-top-level-value!,
;;; top-level-bound?, define-top-level-value.  A program that uses them
;;; registers each of its global variables first (link.scm, with-registry):
;;; NAME -> (getter . setter); a procedure has no setter, since a procedure
;;; that can be replaced is no longer called directly.  Names that are not
;;; in the program get a cell of their own.
(define %registry (make-eq-hashtable))
(define (%register-global! name get set) (hashtable-set! %registry name (cons get set)))
(define (top-level-bound? name) (hashtable-contains? %registry name))
(define (top-level-value name)
  (let ((e (hashtable-ref %registry name #f)))
    (if e ((car e)) (error "top-level-value: unbound variable" name))))
(define (define-top-level-value name value)
  (let ((e (hashtable-ref %registry name #f)))
    (if (and e (cdr e))
        ((cdr e) value)
        (let ((cell value))
          (hashtable-set! %registry name (cons (lambda () cell) (lambda (v) (set! cell v))))))))
(define (set-top-level-value! name value)
  (let ((e (hashtable-ref %registry name #f)))
    (cond ((not e) (define-top-level-value name value))
          ((cdr e) ((cdr e) value))
          (else (error "set-top-level-value!: a compiled procedure cannot be replaced" name)))))
;;; The name of a procedure bound to a global, or #f
(define %named-procedures '())     ; ((procedure . name) ...)
(define (%name-procedures!)
  (set! %named-procedures '())
  (hashtable-walk %registry
                  (lambda (name e)
                    (let ((v ((car e))))
                      (if (procedure? v) (set! %named-procedures (cons (cons v name) %named-procedures)))))))
(define (procedure-name p)
  (let ((hit (assq p %named-procedures)))
    (if hit (cdr hit)
        (begin (%name-procedures!)
               (let ((hit (assq p %named-procedures))) (and hit (cdr hit)))))))

;;; Chez's and SRFI 1's lists ----------------------------------------------------

(define (void) (%unspecified))
(define (add1 n) (+ n 1))
(define (sub1 n) (- n 1))
(define (every p l . ls)
  (if (null? ls)
      (let loop ((l l)) (or (null? l) (if (null? (cdr l)) (p (car l)) (and (p (car l)) (loop (cdr l))))))
      (let loop ((ls (cons l ls)) (last #t))
        (if (%all-pairs? ls)
            (let ((v (apply p (map car ls)))) (and v (loop (map cdr ls) v)))
            last))))
(define (any p l . ls)
  (if (null? ls)
      (let loop ((l l)) (and (pair? l) (or (p (car l)) (loop (cdr l)))))
      (let loop ((ls (cons l ls)))
        (and (%all-pairs? ls) (or (apply p (map car ls)) (loop (map cdr ls)))))))
(define (%all-pairs? ls) (or (null? ls) (and (pair? (car ls)) (%all-pairs? (cdr ls)))))
(define (find-tail p l) (cond ((not (pair? l)) #f) ((p (car l)) l) (else (find-tail p (cdr l)))))
(define (find p l) (let ((t (find-tail p l))) (and t (car t))))
(define (list-index p l)
  (let loop ((l l) (i 0)) (cond ((not (pair? l)) #f) ((p (car l)) i) (else (loop (cdr l) (+ i 1))))))
(define (filter-map f l . ls)
  (let loop ((ls (cons l ls)) (acc '()))
    (if (%all-pairs? ls)
        (let ((v (if (null? (cdr ls)) (f (caar ls)) (apply f (map car ls)))))
          (loop (map cdr ls) (if v (cons v acc) acc)))
        (reverse acc))))
(define (append-map f l . ls) (apply append (apply map f l ls)))
(define (fold kons knil l . ls)
  (if (null? ls)
      (let loop ((acc knil) (l l)) (if (pair? l) (loop (kons (car l) acc) (cdr l)) acc))
      (let loop ((acc knil) (ls (cons l ls)))
        (if (%all-pairs? ls) (loop (apply kons (append (map car ls) (list acc))) (map cdr ls)) acc))))
(define (reduce f ridentity l) (if (null? l) ridentity (fold f (car l) (cdr l))))
(define (remove p l) (filter (lambda (x) (not (p x))) l))
(define (remp p l) (remove p l))
(define (remq x l) (filter (lambda (y) (not (eq? x y))) l))
(define (remv x l) (filter (lambda (y) (not (eqv? x y))) l))
(define (delete x l . same) (let ((same? (if (pair? same) (car same) equal?))) (filter (lambda (y) (not (same? x y))) l)))
(define (memp p l) (find-tail p l))
(define (assp p l) (find (lambda (e) (p (car e))) l))
(define (partition p l)
  (let loop ((l l) (in '()) (out '()))
    (cond ((null? l) (values (reverse in) (reverse out)))
          ((p (car l)) (loop (cdr l) (cons (car l) in) out))
          (else (loop (cdr l) in (cons (car l) out))))))
(define (last l) (car (last-pair l)))
(define (delete-duplicates l . same)
  (let ((same? (if (pair? same) (car same) equal?)))
    (if (and (eq? same? equal?) (> (length l) 16))
        (let ((seen (make-equal-hashtable)))
          (let loop ((l l) (acc '()))
            (cond ((null? l) (reverse acc))
                  ((hashtable-contains? seen (car l)) (loop (cdr l) acc))
                  (else (hashtable-set! seen (car l) #t) (loop (cdr l) (cons (car l) acc))))))
        (let loop ((l l) (acc '()))
          (cond ((null? l) (reverse acc))
                ((any (lambda (y) (same? (car l) y)) acc) (loop (cdr l) acc))
                (else (loop (cdr l) (cons (car l) acc))))))))
(define (reverse! l) (reverse l))
(define (append! . ls) (apply append ls))

;;; Sorting: stable merge sort.  Chez's order, (sort less? list); the
;;; other, (sort list less?), is accepted too.
(define (%merge-sort less? l n)
  (if (<= n 1)
      (if (= n 1) (list (car l)) '())
      (let ((h (quotient n 2)))
        (let merge ((a (%merge-sort less? l h)) (b (%merge-sort less? (list-tail l h) (- n h))) (acc '()))
          (cond ((null? a) (append (reverse acc) b))
                ((null? b) (append (reverse acc) a))
                ((less? (car b) (car a)) (merge a (cdr b) (cons (car b) acc)))
                (else (merge (cdr a) b (cons (car a) acc))))))))
(define (list-sort less? l)
  (if (procedure? less?) (%merge-sort less? l (length l)) (%merge-sort l less? (length less?))))
(define (sort a b)
  (let ((less? (if (procedure? a) a b)) (seq (if (procedure? a) b a)))
    (if (vector? seq)
        (list->vector (%merge-sort less? (vector->list seq) (vector-length seq)))
        (%merge-sort less? seq (length seq)))))
(define (sort! a b) (sort a b))
(define (vector-sort less? v)
  (if (procedure? less?) (sort less? v) (sort v less?)))
(define (vector-sort! less? v)
  (let ((sorted (vector-sort less? v)) (v (if (procedure? less?) v less?)))
    (let loop ((i 0)) (when (< i (vector-length v)) (vector-set! v i (vector-ref sorted i)) (loop (+ i 1))))))

;;; Bits, on fixnums inline; on bigger integers digit by digit
(define (%bits2 op a b)
  (if (and (fixnum? a) (fixnum? b))
      (case op ((and) (%fxand a b)) ((ior) (%fxior a b)) (else (%fxxor a b)))
      (let loop ((a a) (b b) (bit 1) (acc 0))
        (if (and (or (= a 0) (= a -1)) (or (= b 0) (= b -1)))
            (let ((top (case op
                         ((and) (and (= a -1) (= b -1)))
                         ((ior) (or (= a -1) (= b -1)))
                         (else (not (= a b))))))
              (if top (- acc bit) acc))
            (let* ((x (modulo a 2)) (y (modulo b 2))
                   (z (case op ((and) (* x y)) ((ior) (if (= (+ x y) 0) 0 1)) (else (modulo (+ x y) 2)))))
              (loop (floor-quotient a 2) (floor-quotient b 2) (* bit 2) (+ acc (* z bit))))))))
(define (bitwise-and . xs) (fold (lambda (x acc) (%bits2 'and acc x)) -1 xs))
(define (bitwise-ior . xs) (fold (lambda (x acc) (%bits2 'ior acc x)) 0 xs))
(define (bitwise-xor . xs) (fold (lambda (x acc) (%bits2 'xor acc x)) 0 xs))
(define (bitwise-not x) (- -1 x))
(define (logand . xs) (apply bitwise-and xs))
(define (logior . xs) (apply bitwise-ior xs))
(define (logxor . xs) (apply bitwise-xor xs))
(define (lognot x) (- -1 x))
(define (arithmetic-shift n k)
  (cond ((>= k 0) (* n (expt 2 k)))
        ((and (fixnum? n) (> k -31)) (%fxsra n (- k)))
        (else (floor-quotient n (expt 2 (- k))))))
(define (bitwise-arithmetic-shift n k) (arithmetic-shift n k))
(define (ash n k) (arithmetic-shift n k))
(define (bitwise-bit-set? n k) (odd? (arithmetic-shift n (- k))))

;;; Pseudo-random numbers (a 31-bit linear congruential generator)
(define %random-state 20261101)
(define (%random-next!)
  (set! %random-state (modulo (+ (* %random-state 1103515245) 12345) 2147483648))
  %random-state)
(define (random n)
  (if (and (exact-integer? n) (> n 0))
      (modulo (+ (* (%random-next!) 2147483648) (%random-next!)) n)
      (* n (/ (%random-next!) 2147483648.0))))
(define (random-seed n) (set! %random-state (modulo n 2147483648)))

;;; SRFI 13 and 130's strings ------------------------------------------------

(define (string-prefix? p s)
  (let ((n (string-length p)))
    (and (<= n (string-length s))
         (let loop ((i 0)) (or (= i n) (and (char=? (string-ref p i) (string-ref s i)) (loop (+ i 1))))))))
(define (string-suffix? p s)
  (let* ((n (string-length p)) (d (- (string-length s) n)))
    (and (>= d 0)
         (let loop ((i 0)) (or (= i n) (and (char=? (string-ref p i) (string-ref s (+ d i))) (loop (+ i 1))))))))
;;; (string-search-forward pattern string start): where PATTERN starts, or #f
(define (string-search-forward pattern s start)
  (let ((n (string-length pattern)) (m (string-length s)))
    (let loop ((i start))
      (cond ((> (+ i n) m) #f)
            ((let check ((k 0)) (or (= k n) (and (char=? (string-ref pattern k) (string-ref s (+ i k))) (check (+ k 1))))) i)
            (else (loop (+ i 1)))))))
(define (string-contains s pattern . start) (string-search-forward pattern s (if (pair? start) (car start) 0)))
(define (string-index s pred . start)
  (let ((test (%char-test pred)) (n (string-length s)))
    (let loop ((i (if (pair? start) (car start) 0)))
      (cond ((>= i n) #f) ((test (string-ref s i)) i) (else (loop (+ i 1)))))))
(define (string-index-right s pred)
  (let ((test (%char-test pred)))
    (let loop ((i (- (string-length s) 1)))
      (cond ((< i 0) #f) ((test (string-ref s i)) i) (else (loop (- i 1)))))))
;;; a character, a string of characters, or a predicate
(define (%char-test x)
  (cond ((char? x) (lambda (c) (char=? c x)))
        ((string? x) (lambda (c) (let loop ((i 0)) (and (< i (string-length x)) (or (char=? c (string-ref x i)) (loop (+ i 1)))))))
        (else x)))
(define (%trim-test args) (if (pair? args) (%char-test (car args)) char-whitespace?))
(define (string-trim s . what)          ; the left side, as in SRFI 13
  (let ((test (%trim-test what)) (n (string-length s)))
    (let loop ((i 0)) (if (and (< i n) (test (string-ref s i))) (loop (+ i 1)) (substring s i n)))))
(define (string-trim-right s . what)
  (let ((test (%trim-test what)))
    (let loop ((i (string-length s))) (if (and (> i 0) (test (string-ref s (- i 1)))) (loop (- i 1)) (substring s 0 i)))))
(define (string-trim-both s . what) (apply string-trim (apply string-trim-right s what) what))
;;; (string-join strings [separator]): " " by default
(define (string-join strings . separator)
  (let ((sep (if (pair? separator) (car separator) " ")))
    (if (null? strings) ""
        (let loop ((l (cdr strings)) (acc (list (car strings))))
          (if (null? l) (apply string-append (reverse acc))
              (loop (cdr l) (cons (car l) (cons sep acc))))))))
;;; (string-split string [delimiters]): the pieces between any of the
;;; delimiter characters (" " by default), empty ones included
(define (string-split s . delimiters)
  (let ((test (%char-test (if (pair? delimiters) (car delimiters) " "))) (n (string-length s)))
    (let loop ((i 0) (start 0) (acc '()))
      (cond ((= i n) (reverse (cons (substring s start n) acc)))
            ((test (string-ref s i)) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
            (else (loop (+ i 1) start acc))))))
(define (string-reverse s) (list->string (reverse (string->list s))))
(define (string-count s pred)
  (let ((test (%char-test pred)))
    (let loop ((i 0) (k 0)) (if (= i (string-length s)) k (loop (+ i 1) (if (test (string-ref s i)) (+ k 1) k))))))

;;; Chez's bytevectors
(define (bytevector->u8-list b) (vector->list (%bytes b)))
(define (u8-list->bytevector l) (%bv (list->vector l)))
(define (bytevector-fill! b v) (vector-fill! (%bytes b) v))
(define (bytevector=? a b) (equal? (%bytes a) (%bytes b)))
