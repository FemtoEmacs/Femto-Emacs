;;;; prelude.scm -- Schemer's library, in Scheme
;;;;
;;;; Compiled with each program; only the definitions the program reaches
;;;; are kept.  Inside, (car x), (+ a b) ... with the right number of
;;;; arguments are written inline by the compiler; the definitions below
;;;; give the same names as procedures, for (map car l) and the like.

;;; Errors -----------------------------------------------------------------

(define (%type-error code obj)
  (error (cond ((= code 1) "not a number:")
               ((= code 2) "not a small integer:")
               ((= code 3) "division by zero:")
               ((= code 4) "too many arguments to")
               ((= code 5) "not a procedure:")
               ((= code 6) "wrong number of arguments to")
               (else "wrong type:"))
         obj))

;;; Records ------------------------------------------------------------------
;;; A record is a struct of its type and a vector of its fields.  The
;;; library's own types (errors, ports, tables ...) are unique pairs.  The
;;; types a program defines are record-type descriptors, as in R6RS and
;;; Chez Scheme: rtds, themselves records of %rtd-type, with a parent; a
;;; record's fields are its ancestors' fields, then its own.

(define (%record-of? x type) (and (%record? x) (eq? (%record-tag x) type)))
(define (%record-error obj who) (error "wrong type of argument to" who obj))

;; rtd fields: 0 name, 1 parent, 2 uid, 3 sealed?, 4 opaque?, 5 own fields
;; (a vector of (mutable name) / (immutable name)), 6 all fields counted
;; with the ancestors', 7 the default constructor descriptor
(define %rtd-type (cons (quote record-type-descriptor) (quote ())))
(define %rcd-type (cons (quote record-constructor-descriptor) (quote ())))
(define %nongenerative (cons (quote nongenerative) (quote ())))   ; uid -> rtd, an alist
(define (%rf r i) (vector-ref (%record-fields r) i))
(define (record-type-descriptor? x) (%record-of? x %rtd-type))
(define (record-constructor-descriptor? x) (%record-of? x %rcd-type))
(define (%check-rtd x who) (if (record-type-descriptor? x) x (error "not a record-type descriptor:" who x)))

(define (make-record-type-descriptor name parent uid sealed? opaque? fields)
  (if parent (begin (%check-rtd parent (quote make-record-type-descriptor))
                    (if (%rf parent 3) (error "the parent record type is sealed:" (%rf parent 0)))))
  (let ((old (and uid (assq uid (cdr %nongenerative)))))
    (if old
        (cdr old)
        (let* ((fields (if (vector? fields) fields (list->vector fields)))
               (rtd (%make-record %rtd-type
                                  (vector name parent uid sealed?
                                          (or opaque? (and parent (%rf parent 4)))
                                          fields
                                          (+ (vector-length fields) (if parent (%rf parent 6) 0))
                                          #f))))
          (if uid (set-cdr! %nongenerative (cons (cons uid rtd) (cdr %nongenerative))))
          rtd))))

(define (record-type-name rtd) (%rf (%check-rtd rtd (quote record-type-name)) 0))
(define (record-type-parent rtd) (%rf (%check-rtd rtd (quote record-type-parent)) 1))
(define (record-type-uid rtd) (%rf (%check-rtd rtd (quote record-type-uid)) 2))
(define (record-type-generative? rtd) (not (record-type-uid rtd)))
(define (record-type-sealed? rtd) (%rf (%check-rtd rtd (quote record-type-sealed?)) 3))
(define (record-type-opaque? rtd) (%rf (%check-rtd rtd (quote record-type-opaque?)) 4))
(define (record-type-field-names rtd)
  (let* ((fs (%rf (%check-rtd rtd (quote record-type-field-names)) 5))
         (v (make-vector (vector-length fs) #f)))
    (do ((i 0 (+ i 1))) ((= i (vector-length fs)) v) (vector-set! v i (cadr (vector-ref fs i))))))
(define (record-field-mutable? rtd k)
  (eq? (car (vector-ref (%rf (%check-rtd rtd (quote record-field-mutable?)) 5) k)) (quote mutable)))

;; is the record type T RTD or one of its descendants?
(define (%rtd-descends? t rtd)
  (cond ((eq? t rtd) #t)
        ((record-type-descriptor? t) (let ((p (%rf t 1))) (and p (%rtd-descends? p rtd))))
        (else #f)))
(define (%instance-of? x rtd) (and (%record? x) (%rtd-descends? (%record-tag x) rtd)))
(define (record? x . rtd)
  (and (%record? x)
       (let ((t (%record-tag x)))
         (if (pair? rtd)
             (%rtd-descends? t (car rtd))
             (and (record-type-descriptor? t) (not (%rf t 4)))))))
(define (record-rtd x)
  (if (record? x) (%record-tag x) (error "not a record, or an opaque one:" x)))

(define (record-predicate rtd)
  (%check-rtd rtd (quote record-predicate))
  (if (%rf rtd 3)
      (lambda (x) (%record-of? x rtd))      ; sealed: no descendants
      (lambda (x) (%instance-of? x rtd))))
(define (%field-index rtd k who)
  (%check-rtd rtd who)
  (if (and (fixnum? k) (>= k 0) (< k (vector-length (%rf rtd 5))))
      (+ k (- (%rf rtd 6) (vector-length (%rf rtd 5))))
      (error "no such field:" who k)))
(define (record-accessor rtd k)
  (let ((i (%field-index rtd k (quote record-accessor))))
    (lambda (x) (if (%instance-of? x rtd) (vector-ref (%record-fields x) i)
                    (%record-error x (list (record-type-name rtd) (cadr (vector-ref (%rf rtd 5) k))))))))
(define (record-mutator rtd k)
  (let ((i (%field-index rtd k (quote record-mutator))))
    (if (not (record-field-mutable? rtd k)) (error "the field is immutable:" (cadr (vector-ref (%rf rtd 5) k))))
    (lambda (x v) (if (%instance-of? x rtd) (vector-set! (%record-fields x) i v)
                      (%record-error x (list (record-type-name rtd) (cadr (vector-ref (%rf rtd 5) k))))))))

;; constructor descriptors: fields 0 rtd, 1 parent descriptor, 2 protocol
(define (make-record-constructor-descriptor rtd parent-rcd protocol)
  (%check-rtd rtd (quote make-record-constructor-descriptor))
  (let ((parent-rcd (or parent-rcd (and (%rf rtd 1) (%default-rcd (%rf rtd 1))))))
    (%make-record %rcd-type (vector rtd parent-rcd protocol))))
(define (%default-rcd rtd)
  (or (%rf rtd 7)
      (let ((rcd (make-record-constructor-descriptor rtd #f #f)))
        (vector-set! (%record-fields rtd) 7 rcd)
        rcd)))
;; define-record-type with a protocol: that descriptor is the type's own
(define (%set-rtd-rcd! rtd rcd) (vector-set! (%record-fields rtd) 7 rcd) rcd)
(define (record-type-descriptor rtd) (%check-rtd rtd (quote record-type-descriptor)))
(define (record-constructor-descriptor rtd) (%rtd-rcd rtd))
;; Chez define-record's constructor: the parent's fields, then N own
(define (%chez-construct rtd n args k)
  (let ((np (if (%rf rtd 1) (%rf (%rf rtd 1) 6) 0)))
    (if (= (length args) (+ np n))
        (apply k (list-head args np) (list-tail args np))
        (error "wrong number of arguments to the constructor of" (%rf rtd 0) args))))
;; (record-constructor-descriptor NAME) of a define-record-type
(define (%rtd-rcd rtd) (%default-rcd (%check-rtd rtd (quote record-constructor-descriptor))))

;; The protocol of a level gets a procedure P: for a type without parent, P
;; takes the type's fields and makes the record; with a parent, P takes the
;; parent constructor's arguments and gives a procedure of the type's own
;; fields.  AFTER: the fields of the descendants, already known.
(define (%rcd-protocol rcd)
  (or (%rf rcd 2)
      (let ((rtd (%rf rcd 0)))
        (if (%rf rtd 1)
            (let ((n-parent (%rf (%rf rtd 1) 6)))   ; default: the parent's fields, then ours
              (lambda (p) (lambda args
                            (let loop ((i 0) (as args) (parent-args (quote ())))
                              (if (< i n-parent)
                                  (if (pair? as) (loop (+ i 1) (cdr as) (cons (car as) parent-args))
                                      (error "too few arguments to the constructor of" (record-type-name rtd)))
                                  (apply (apply p (reverse parent-args)) as))))))
            (lambda (p) p)))))
(define (record-constructor rcd)
  (if (not (record-constructor-descriptor? rcd)) (error "not a record-constructor descriptor:" rcd))
  ;; the record's type: the descriptor's own (the most derived)
  ((%rcd-protocol rcd) (%rcd-maker* rcd (quote ()) (%rf rcd 0))))
(define (%rcd-maker* rcd after final-rtd)
  (let* ((rtd (%rf rcd 0)) (n (vector-length (%rf rtd 5))) (parent (%rf rcd 1)))
    (define (own fields)
      (if (= (length fields) n) (append fields after)
          (error "wrong number of fields for" (record-type-name rtd) fields)))
    (if parent
        (lambda parent-args
          (lambda fields
            (apply ((%rcd-protocol parent) (%rcd-maker* parent (own fields) final-rtd)) parent-args)))
        (lambda fields (%make-record final-rtd (list->vector (own fields)))))))

;; Chez's (make-record-type name fields) and (make-record-type parent name
;; fields): a generative type; fields are names or (mutable name).
(define (make-record-type a b . c)
  (let* ((parent (if (pair? c) a #f)) (name (if (pair? c) b a)) (fields (if (pair? c) (car c) b)))
    (make-record-type-descriptor (if (string? name) (string->symbol name) name) parent #f #f #f
      (map (lambda (f) (cond ((symbol? f) (list (quote mutable) f))
                             ((string? f) (list (quote mutable) (string->symbol f)))
                             (else f)))
           fields))))
(define (record-field-accessor rtd name) (record-accessor rtd (%field-number rtd name)))
(define (record-field-mutator rtd name) (record-mutator rtd (%field-number rtd name)))
(define (%field-number rtd name)
  (let ((fs (%rf (%check-rtd rtd (quote record-field-accessor)) 5)) (name (if (string? name) (string->symbol name) name)))
    (let loop ((i 0))
      (cond ((= i (vector-length fs)) (error "no such field:" name))
            ((eq? (cadr (vector-ref fs i)) name) i)
            (else (loop (+ i 1)))))))

;;; Escapes, exceptions -----------------------------------------------------
;;; (%catch thunk tag), (%throw tag value), (%protect thunk after): the host
;;; does them with its own exceptions.  Continuations escape only: one
;;; called after its procedure returned is an error.

(define (call-with-current-continuation f)
  (let* ((tag (cons (quote continuation) (quote ()))) (saved %handlers)
         (v (%catch (lambda ()
                      (f (lambda vals
                           (%throw tag (if (and (pair? vals) (null? (cdr vals))) (car vals) (apply values vals))))))
                    tag)))
    (set! %handlers saved)
    v))
(define (call/cc f) (call-with-current-continuation f))
(define (dynamic-wind before thunk after)
  (before)
  (%protect thunk after))

;;; %handlers: the handlers, innermost first.  A handler is a procedure
;;; (with-exception-handler) or a guard's tag, a pair: raising to a tag
;;; throws to its guard.  Whatever catches an escape (a guard, call/cc)
;;; puts back the handlers it started with.
(define %handlers (quote ()))
(define %guard-hit #f)          ; the tag of the guard thrown to
(define (with-exception-handler handler thunk)
  (let ((saved %handlers))
    (set! %handlers (cons handler saved))
    (%protect thunk (lambda () (set! %handlers saved)))))
(define (raise-continuable obj)
  (if (null? %handlers)
      (%uncaught obj)
      (let ((saved %handlers))
        (if (pair? (car saved))
            (begin (set! %guard-hit (car saved)) (%throw (car saved) obj))
            (begin
              (set! %handlers (cdr saved))
              (let ((v ((car saved) obj)))
                (set! %handlers saved)
                v))))))
;;; (guard (e clause ...) body ...) is (%guard (lambda () body ...)
;;; (lambda (e) (cond clause ... (else (raise-continuable e))))): the
;;; handler runs after the escape, with the guard's own handlers
(define (%guard thunk handler)
  (let* ((saved %handlers) (tag (cons (quote guard) saved)))
    (set! %handlers (cons tag saved))
    (let ((r (%catch thunk tag)))
      (set! %handlers saved)
      (if (eq? %guard-hit tag)
          (begin (set! %guard-hit #f) (handler r))
          r))))
(define (raise obj)
  (raise-continuable obj)
  (set! %handlers (quote ()))
  (error "an exception handler returned from raise:" obj))

(define %error-type (cons (quote error) (quote (message irritants kind))))   ; cons: ready before the library
(define (error msg . irritants)
  (raise (%make-record %error-type (vector msg irritants #f))))
(define (error-object? x) (%record-of? x %error-type))
(define (error-object-message e) (vector-ref (%record-fields e) 0))
(define (error-object-irritants e) (vector-ref (%record-fields e) 1))
(define (read-error? x) #f)
(define (file-error? x) (and (error-object? x) (eq? (vector-ref (%record-fields x) 2) (quote file))))
(define (%uncaught obj)
  (set! %out #f)   ; the message goes to the page, even from inside a string port
  (display "Error: ")
  (if (error-object? obj)
      (begin (display (error-object-message obj))
             (for-each (lambda (o) (write-char #\space) (write o)) (error-object-irritants obj)))
      (begin (display "uncaught exception: ") (write obj)))
  (newline)
  (%abort obj))
(define (exit . code) (%abort #f))
(define (emergency-exit . code) (%abort #f))

;;; The editor's procedures (link.scm, *editor-procedures*): the call goes
;;; to the editor as text, (name argument ...), written; the editor answers
;;; "ok VALUE" (VALUE written) or "error MESSAGE".  Arguments and values
;;; are data: numbers, strings, symbols, lists...; not procedures.
;;; The answer is decoded by %DECODE-DATUM, not READ: the reader (and
;;; string->number) would be compiled into every program that calls the
;;; editor, more than a second of compiling each time.
(define (%editor-apply name args)
  (let* ((reply (%editor (with-output-to-string (lambda () (write (cons name args))))))
         (n (string-length reply)))
    (cond ((and (>= n 3) (string=? (substring reply 0 3) "ok "))
           (let ((v (%decode-datum (substring reply 3 n))))
             (if (eq? v %no-datum) (%unspecified) v)))
          (else (error (string-append "the editor's " (symbol->string name) ": "
                                      (if (> n 6) (substring reply 6 n) reply)))))))

;;; (%decode-datum text): the datum WRITE wrote in TEXT -- booleans,
;;; numbers, characters, strings, symbols, lists, vectors, bytevectors --
;;; or %NO-DATUM (#<...>, or nothing)
(define %no-datum (cons (quote no) (quote datum)))
(define (%decode-datum text)
  (let ((n (string-length text)) (i 0))
    (define (peek) (if (< i n) (string-ref text i) #\nul))
    (define (next!) (let ((c (peek))) (set! i (+ i 1)) c))
    (define (skip!) (if (and (< i n) (char-whitespace? (peek))) (begin (set! i (+ i 1)) (skip!))))
    (define (delimiter? c) (or (char-whitespace? c) (char=? c #\() (char=? c #\)) (char=? c #\") (char=? c #\;)))
    (define (token) (let loop ((acc (quote ())))
                      (if (and (< i n) (not (delimiter? (peek)))) (loop (cons (next!) acc)) (list->string (reverse acc)))))
    (define (digit c) (- (char->integer c) 48))
    (define (hex-digit c)                ; 0-9, a-f, A-F (char-downcase would bring its tables)
      (let ((k (char->integer c)))
        (cond ((and (>= k 48) (<= k 57)) (- k 48)) ((and (>= k 97) (<= k 102)) (- k 87)) ((and (>= k 65) (<= k 70)) (- k 55)) (else 0))))
    (define (number t)                   ; #f when T is not a number
      (let ((m (string-length t)))
        (let loop ((k (if (and (> m 1) (or (char=? (string-ref t 0) #\-) (char=? (string-ref t 0) #\+))) 1 0)) (int 0) (frac #f) (scale 1) (digits 0))
          (cond ((= k m)
                 (and (> digits 0)
                      (let ((v (if frac (/ (exact->inexact int) scale) int)))
                        (if (char=? (string-ref t 0) #\-) (- v) v))))
                ((char-numeric? (string-ref t k))
                 (loop (+ k 1) (+ (* int 10) (digit (string-ref t k))) frac (if frac (* scale 10) scale) (+ digits 1)))
                ((and (char=? (string-ref t k) #\.) (not frac)) (loop (+ k 1) int #t scale digits))
                ((and (or (char=? (string-ref t k) #\e) (char=? (string-ref t k) #\E)) (> digits 0))
                 (let ((e (number (substring t (+ k 1) m)))
                       (mant (if frac (/ (exact->inexact int) scale) (exact->inexact int))))
                   (and (exact-integer? e)
                        (let* ((p (let pow ((x 1.0) (j (abs e))) (if (= j 0) x (pow (* x 10.0) (- j 1)))))
                               (v (if (< e 0) (/ mant p) (* mant p))))
                          (if (char=? (string-ref t 0) #\-) (- v) v)))))
                (else #f)))))
    (define (char-named t)
      (cond ((= (string-length t) 1) (string-ref t 0))
            ((string=? t "space") #\space) ((string=? t "newline") #\newline) ((string=? t "tab") #\tab)
            ((string=? t "nul") #\nul) ((string=? t "null") #\nul) ((string=? t "return") #\return)
            ((string=? t "alarm") #\alarm) ((string=? t "backspace") #\backspace) ((string=? t "delete") #\delete)
            ((string=? t "escape") #\escape) ((string=? t "altmode") #\escape) ((string=? t "linefeed") #\newline)
            ((and (> (string-length t) 1) (char=? (string-ref t 0) #\x))
             (let loop ((k 1) (v 0))
               (if (= k (string-length t)) (integer->char v)
                   (loop (+ k 1) (+ (* v 16) (hex-digit (string-ref t k)))))))
            ;; a character other than the named ones: as written
            (else (string-ref t 0))))
    (define (string-body close)
      (let loop ((acc (quote ())))
        (let ((c (next!)))
          (cond ((or (char=? c close) (> i n)) (list->string (reverse acc)))
                ((char=? c #\\)
                 (let ((e (next!)))
                   (case e
                     ((#\n) (loop (cons #\newline acc)))
                     ((#\t) (loop (cons #\tab acc)))
                     ((#\r) (loop (cons #\return acc)))
                     ((#\a) (loop (cons #\alarm acc)))
                     ((#\x) (let hex ((v 0))
                              (let ((h (next!)))
                                (if (or (char=? h #\;) (> i n)) (loop (cons (integer->char v) acc))
                                    (hex (+ (* v 16) (hex-digit h)))))))
                     (else (loop (cons e acc))))))
                (else (loop (cons c acc)))))))
    (define (items close)                ; the data up to CLOSE, a dotted tail too
      (let loop ((acc (quote ())))
        (skip!)
        (cond ((>= i n) (reverse acc))
              ((char=? (peek) close) (next!) (reverse acc))
              ((and (char=? (peek) #\.) (< (+ i 1) n) (delimiter? (string-ref text (+ i 1))))
               (next!)
               (let ((tail (datum)))
                 (skip!)
                 (if (char=? (peek) close) (next!))
                 (let build ((l acc) (r tail)) (if (null? l) r (build (cdr l) (cons (car l) r))))))
              (else (loop (cons (datum) acc))))))
    (define (datum)
      (skip!)
      (let ((c (peek)))
        (cond ((>= i n) %no-datum)
              ((char=? c #\() (next!) (items #\)))
              ((char=? c #\") (next!) (string-body #\"))
              ((char=? c #\|) (next!) (string->symbol (string-body #\|)))
              ((char=? c #\') (next!) (list (quote quote) (datum)))
              ((char=? c #\#)
               (next!)
               (let ((d (peek)))
                 (cond ((char=? d #\() (next!) (list->vector (items #\))))
                       ((char=? d #\\) (next!) (let ((first (next!))) (char-named (string-append (string first) (token)))))
                       ((char=? d #\u) (token) (next!) (u8-list->bytevector (items #\))))
                       ((char=? d #\<) (set! i n) %no-datum)
                       (else (let ((t (token)))
                               (cond ((or (string=? t "t") (string=? t "true")) #t)
                                     ((or (string=? t "f") (string=? t "false")) #f)
                                     (else %no-datum)))))))
              (else (let ((t (token))) (or (number t) (string->symbol t)))))))
    (let ((v (datum))) v)))

;;; Parameters: (p) is the value; (p %param-set v) changes it
(define %param-set (cons (quote set) (quote ())))
(define %param-convert (cons (quote convert) (quote ())))
(define (make-parameter value . converter)
  (let* ((convert (if (null? converter) (lambda (x) x) (car converter)))
         (v (convert value)))
    (lambda args
      (cond ((null? args) v)
            ((eq? (car args) %param-set) (set! v (cadr args)))
            ((eq? (car args) %param-convert) (convert (cadr args)))
            (else (set! v (car args)))))))
(define (%parameterize params values thunk)
  (let ((new (map (lambda (p v) (p %param-convert v)) params values))
        (old (map (lambda (p) (p)) params)))
    (dynamic-wind
     (lambda () (for-each (lambda (p v) (p %param-set v)) params new))
     thunk
     (lambda () (for-each (lambda (p v) (p %param-set v)) params old)))))

;;; Procedures for the inline primitives ----------------------------------

(define (car x) (car x))
(define (cdr x) (cdr x))
(define (cons a b) (cons a b))
(define (set-car! p v) (set-car! p v))
(define (set-cdr! p v) (set-cdr! p v))
(define (null? x) (null? x))
(define (pair? x) (pair? x))
(define (eq? a b) (eq? a b))
(define (not x) (not x))
(define (boolean? x) (boolean? x))
(define (symbol? x) (symbol? x))
(define (string? x) (string? x))
(define (char? x) (char? x))
(define (vector? x) (vector? x))
(define (procedure? x) (procedure? x))
(define (vector-ref v k) (vector-ref v k))
(define (vector-set! v k x) (vector-set! v k x))
(define (vector-length v) (vector-length v))
(define (string-length s) (string-length s))
(define (string-ref s k) (string-ref s k))
(define (string-set! s k c) (string-set! s k c))
(define (char->integer c) (char->integer c))
(define (integer->char n) (integer->char n))
(define (zero? x) (zero? x))
(define (quotient a b) (quotient a b))
(define (remainder a b) (remainder a b))
(define (modulo a b) (modulo a b))
(define (caar x) (caar x)) (define (cadr x) (cadr x)) (define (cdar x) (cdar x))
(define (cddr x) (cddr x)) (define (caddr x) (caddr x)) (define (cdddr x) (cdddr x))
