/*
 * editor-functions.def -- the C core's functions that Scheme calls by name
 *
 * Read by awk only, never compiled: tools/gen-bridge.awk makes
 * src/bridge-functions.c from it, and tools/gen-bridge-scheme.awk
 * compiled/editor-functions.scm (make).  An "extern" line gives a
 * function's C type; a {"scheme-name", wrap_c_name} line its Scheme name.
 * Until 27 November 2026 this was src/native.c, which also wrapped every
 * function for femtoscheme.
 */
