   ;; eval.scm: EVAL-STRING, against femtoscheme's own
   ("eval-string"
    (map (lambda (s) (guard (e (#t 'error)) (eval-string s)))
         '("(+ 1 2)" "(define (sq x) (* x x)) (sq 7)" "(define x 5) (set! x (+ x 1)) x"
           "(let loop ((i 0) (acc '())) (if (= i 5) (reverse acc) (loop (+ i 1) (cons i acc))))"
           "`(1 ,(+ 1 1) ,@(list 3 4) (n ,(* 2 3)))"
           "(let-values (((a b) (values 1 2)) ((c) (values 3))) (list a b c))"
           "(case 3 ((1 2) 'low) ((3 4) 'mid) (else 'high))" "(case 9 ((1) 'a) (else 'other))"
           "(do ((i 0 (+ i 1)) (s 0 (+ s i))) ((= i 5) s))"
           "(define-syntax my-or (syntax-rules () ((_) #f) ((_ e) e) ((_ e r ...) (let ((t e)) (if t t (my-or r ...)))))) (list (my-or) (my-or #f 3) (my-or 1 2))"
           "(define-syntax my-let* (syntax-rules () ((_ () body ...) (let () body ...)) ((_ ((n v) rest ...) body ...) (let ((n v)) (my-let* (rest ...) body ...))))) (my-let* ((a 1) (b (+ a 1))) (list a b))"
           "(guard (e ((string? e) (string-append \"caught \" e))) (raise \"x\"))"
           "(guard (e ((symbol? e) 'sym) ((string? e) 'str)) (raise 'oops))"
           "(guard (e (#t (error-object-message e))) (error \"boom\" 1))"
           "(letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1))))) (od? (lambda (n) (if (= n 0) #f (ev? (- n 1)))))) (list (ev? 100) (od? 7)))"
           "((lambda args args) 1 2 3)" "((lambda (a . r) (list a r)) 1 2 3)" "(apply + 1 2 '(3 4))"
           "(call/cc (lambda (k) (+ 1 (k 42))))" "(let* ((x 1) (y (+ x 1))) (* x y))"
           "(cond ((assv 2 '((1 . a) (2 . b))) => cdr) (else 'none))" "(cond (#f 1) (else 2))"
           "(string-append \"a\" (number->string 12))" "(and 1 2 3)" "(and)" "(or #f #f)" "(or)"
           "(map (lambda (x y) (+ x y)) '(1 2) '(10 20))"
           "(let () (define a 1) (define (g) (+ a 1)) (g))"
           "(define (count-up n) (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i))) (count-up 100000)"
           "(let ((v (make-vector 3 0))) (vector-set! v 1 'x) v)" "(string->symbol \"abc\")" "'(a . b)" "#\\a"
           "(no-such-procedure-here 1)" "(1 2)" "(car)" "(if)" "(trycatch (error \"x\") (lambda (e) 'handled))"
           "(when (> 1 0) 'yes)" "(unless (< 1 0) 'yes)" "(let ((x 1)) (set! x 2) x)"
           "(list (quotient 17 5) (remainder 17 5) (exact->inexact 1) (expt 2 10))"
           "(dynamic-wind (lambda () #f) (lambda () 'body) (lambda () #f))"
           "(with-output-to-string (lambda () (display \"out\") (write \"q\")))"
           "(let ((p (open-output-string))) (write '(1 \"two\" #\\3) p) (get-output-string p))")))
