;;; scripts-cases.scm -- the compiled scripts against femtoscheme's
;;;
;;; tests/run-scripts.sh evaluates every case twice: in femtoscheme, with
;;; the scripts of scheme/, and compiled, with those of compiled/scripts/.
;;; Both must give the same values.  Each case is (name expression); its
;;; value is written, or ERROR when it raised one.  Only what both dialects
;;; share is used here: the scripts' own procedures, R7RS.  TEST-BYTES
;;; makes the buffer text the scripts scan from a string: femtoscheme's
;;; byte string, or a bytevector compiled; TEST-TEXT turns them back.

(define (test-hook-fn . args) (set! *test-hook-calls* (cons args *test-hook-calls*)))
(define *test-hook-calls* '())
(define *test-hook* '())
(define (ind language . ls) (indentation-for-text language (string-join ls "\n")))
(define (faces string file)
  (filter (lambda (run) (not (memv (car run) (list +alpha+ +symbol+)))) (highlight-string string file)))
(define (undo-summary id)
  (let ((h (history-of id)))
    (list (map (lambda (g) (map (lambda (c) (list (change-kind c) (change-pos c) (test-text (change-text c))))
                                (undo-group-changes g)))
               (undo-history-done h))
          (length (undo-history-undone h)) (undo-history-bytes h) (= (undo-history-saved-id h) (top-id h)))))
(define (lines . ls) (string-join ls "\n"))
(define (md string) (faces string "x.md"))
(define (wrap-rows text width)
  (let loop ((t (test-bytes text)) (rows '()))
    (if (= 0 (bytes-length t)) (reverse rows)
        (let ((end (markdown-wrap-end t width)))
          (loop (byte-substring t end) (cons (test-text (byte-substring t 0 end)) rows))))))
(define *complete-dir* "/tmp/chezemax-scripts-complete")
(define (at f string i . args) (apply f (octets-get (test-bytes string)) (bytes-length string) i args))
(define (decoded-mode-line name line flags cols)
  (let ((encoded (mode-line-pieces name "" name line flags cols)))
    (and encoded
         (map (lambda (piece)
                (let* ((parts (string-split piece (string (integer->char 31)))))
                  (list (caddr parts) (string->number (car parts)) (> (string->number (cadr parts)) 0))))
              (string-split encoded (string (integer->char 30)))))))
(define (mode-line-string name line flags cols)
  (apply string-append (map car (decoded-mode-line name line flags cols))))
(define (set-buffer-text! text) (fe-delete-region 0 (buffer-size)) (fe-set-point 0) (insert text) (fe-set-point 0))
(define-indentation "T Python" 'style 'python 'width 4 'tabs #f)
(define-language "T Bytes" 'extensions '(".tby") 'line-comment "--" 'strings '("\"" "«")
  'keywords '("ação" "fim"))

