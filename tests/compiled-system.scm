;;; compiled-system.scm -- make check-bridge: the C functions of
;;; compiled/system.scm (src/bridge-more.c) from compiled Scheme.  C-c s
;;; inserts one line per check: what each gave, written.
(define (system-report)
  (let ((path "/tmp/chezemax-system-test.txt"))
    (call-with-output-file path (lambda (p) (write-string "abc" p)))
    (fe-insert-bytes 0 (string->utf8 "xy"))
    (let ((results
           (list
            (os-name)
            (list (path.exists? "makefile") (path.exists? "no-such-file"))
            (car (file-attributes "tests"))
            (file-attributes "no-such-file")
            (file-executable? "chezemax")
            (run-program "echo" '("hello" "world") #f 5 #f)
            (run-program "cat" '() "piped" 5 #f)
            (begin (os.setenv "CHEZEMAX_T" "v1") (os.getenv "CHEZEMAX_T"))
            (os.getenv "NO_SUCH_VAR_X")
            (> (string-length *install-dir*) 0)
            (> (length (directory-files "tests")) 2)
            (file-contents path)
            (let* ((id (fe-define-token-language "-" '(";") '(("#|" . "|#")) '("\"") 92 #f #f #f '("define")))
                   (text (string->utf8 "(define x) ; c"))
                   (colors (make-bytevector (bytevector-length text) 0)))
              (fe-highlight-tokens id text colors)
              (bytevector->u8-list colors))
            (let* ((text (string->utf8 "# T\n```scheme\n(x)\n```\n"))
                   (colors (make-bytevector (bytevector-length text) 0)))
              (fe-highlight-markdown text colors))
            (buffer-substring 0 2)
            (string-length (format-time 0))
            (equal? (real-path ".") (path.cwd))
            (> (getpid) 0)
            (list (in-browser?) (buffer-read-only?)))))
      (delete-file path)
      (fe-set-point (fe-buffer-size))
      (for-each (lambda (r) (fe-insert (let ((p (open-output-string))) (write r p) (get-output-string p))) (fe-insert "\n"))
                results))))
(compiled-key! "C-c s" system-report)
