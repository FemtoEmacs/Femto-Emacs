(define (show x) (write x) (newline))
(show (number->string 1.5))
(show (number->string 3.0))
(show (number->string (/ 1. 3)))
(show (number->string (sqrt 2)))
(show (number->string -2.5e-10))
(show (number->string 1e300))
(show (number->string (/ 1. 0)))
(show (number->string (- 0 (/ 1. 0))))
(show (number->string 42))
(show (number->string 255 16))
(show (string-append "pi = " (number->string (* 4 (atan 1)))))
(display 2.0) (newline)
(display (/ 0. 0)) (newline)
