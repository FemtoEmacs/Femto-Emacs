;; bytevectors, packed one byte a byte (prelude.scm %bv, compiler.scm %make-bytes)
(define b (make-bytevector 5 7))
(write b) (newline)
(bytevector-u8-set! b 0 255)
(bytevector-u8-set! b 4 128)
(write (list (bytevector-length b) (bytevector-u8-ref b 0) (bytevector-u8-ref b 4) (bytevector? b) (vector? b))) (newline)
(write (bytevector 1 2 3)) (write (bytevector 0 200 255)) (write (make-bytevector 0)) (newline)
(write (bytevector-copy (bytevector 1 2 3 4 5) 1 4)) (write (bytevector-copy (bytevector 9 8))) (newline)
(define c (make-bytevector 6 0))
(bytevector-copy! c 1 (bytevector 10 11 12 13) 1 3)
(write c) (newline)
(define d (bytevector 1 2 3 4 5 6))
(bytevector-copy! d 2 d 0 4)              ; overlapping
(write d) (newline)
(write (bytevector-append (bytevector 1) (bytevector) (bytevector 2 3) (bytevector 250))) (newline)
(write (list (equal? (bytevector 1 2 3) (bytevector 1 2 3)) (equal? (bytevector 1 2) (bytevector 1 2 3)) (equal? (bytevector 1 2 4) (bytevector 1 2 3))
             (bytevector=? (bytevector) (bytevector)) (equal? (list (bytevector 5) "x") (list (bytevector 5) "x"))))
(newline)
(write (= (equal-hash (bytevector 1 2 3)) (equal-hash (bytevector 1 2 3)))) (newline)
(write (bytevector->u8-list (bytevector 3 2 1))) (write (u8-list->bytevector '(0 127 128 255))) (newline)
(define f (make-bytevector 3 0)) (bytevector-fill! f 9) (write f) (newline)
(define u (string->utf8 "aé€😀"))
(write (list (bytevector-length u) (bytevector->u8-list u))) (newline)
(write (utf8->string u)) (write (utf8->string u 1 3)) (write (string->utf8 "abc" 1)) (newline)
(write (utf8->string (string->utf8 "λx. ω — ok"))) (newline)
;; a large one: a million bytes, all read back
(define big (make-bytevector 1000000 0))
(let loop ((i 0)) (when (< i 1000000) (bytevector-u8-set! big i (remainder i 256)) (loop (+ i 1))))
(write (let loop ((i 0) (s 0)) (if (= i 1000000) s (loop (+ i 1) (+ s (bytevector-u8-ref big i)))))) (newline)
;; not a byte: an error, not a silent truncation
(write (guard (e (#t 'refused)) (bytevector-u8-set! b 0 256) 'stored)) 
(write (guard (e (#t 'refused)) (bytevector-u8-set! b 0 -1) 'stored))
(write (guard (e (#t 'refused)) (make-bytevector 2 300) 'made))
(write (bytevector-u8-ref b 0)) (newline)
