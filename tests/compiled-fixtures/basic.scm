;; closures, let, letrec, named let, set!, tail calls
(define (make-counter)
  (let ((n 0))
    (lambda () (set! n (+ n 1)) n)))
(define c (make-counter))
(c) (c)
(display (c)) (newline)
(define (loop i acc) (if (= i 0) acc (loop (- i 1) (+ acc 1))))
(display (loop 10000000 0)) (newline)
(display (let loop ((i 0) (s 0)) (if (> i 100) s (loop (+ i 1) (+ s i))))) (newline)
(letrec ((even? (lambda (n) (if (= n 0) #t (odd? (- n 1)))))
         (odd? (lambda (n) (if (= n 0) #f (even? (- n 1))))))
  (display (list (even? 1000001) (odd? 7))) (newline))
(define (f . args) args)
(display (f 1 2 3)) (newline)
(define (g a b . rest) (list a b rest))
(display (g 1 2)) (display (g 1 2 3 4)) (newline)
(display (apply + 1 2 '(3 4))) (newline)
(display (map (lambda (x) (* x x)) '(1 2 3))) (newline)
(display (map + '(1 2) '(10 20))) (newline)
(define v (make-vector 3 0))
(vector-set! v 1 'x)
(write v) (newline)
(write (list "a\"b" #\a 'sym 1.5 -7 (/ 1 3) (/ 6 3))) (newline)
(display (string-append "foo" "bar")) (newline)
(display (symbol->string 'hello)) (newline)
(display (eq? 'abc (string->symbol "abc"))) (newline)
(display `(1 ,(+ 1 1) ,@(list 3 4))) (newline)
(display (case 3 ((1 2) 'low) ((3 4) 'mid) (else 'high))) (newline)
(display (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 4) acc))) (newline)
(display (* 100000 100000)) (newline)
(display (+ 1073741823 1)) (newline)
(display (assoc "b" '(("a" . 1) ("b" . 2)))) (newline)
(display (equal? '(1 (2 #(3))) '(1 (2 #(3))))) (newline)
(display (let* ((x 1) (y (+ x 1))) (* x y))) (newline)
(display (cond ((assv 2 '((1 . a) (2 . b))) => cdr) (else 'none))) (newline)
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(display (fact 10)) (newline)
(display (vector-map (lambda (x) (+ x 1)) #(1 2 3))) (newline)
(display (number->string 255 16)) (newline)
(display (string->number "-42")) (newline)
(display (list (quotient 17 5) (remainder -17 5) (modulo -17 5))) (newline)
(display (sqrt 16)) (newline)
(display (exact->inexact 1)) (newline)
(display (reverse '(1 2 3))) (newline)
(display (length '(1 2 3 4))) (newline)
(display (list->string (list #\a #\b))) (newline)
(for-each (lambda (x) (display x) (display " ")) '(1 2 3)) (newline)
(display (let ((p (delay (begin (display "once ") 5)))) (+ (force p) (force p)))) (newline)
(define x 10)
(define (add-x y) (+ x y))
(set! x 20)
(display (add-x 1)) (newline)
(display (max 1 5 3)) (display (min 4 2 8)) (newline)
(display (< 1 2 3)) (display (< 1 3 2)) (newline)
