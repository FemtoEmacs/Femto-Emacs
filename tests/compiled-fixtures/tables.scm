(define t (make-equal-hashtable))
(hashtable-set! t '(1 2) 'a) (hashtable-set! t "str" 'b) (hashtable-set! t 3.5 'c)
(display (list (hashtable-ref t (list 1 2) #f) (hashtable-ref t "str" #f) (hashtable-ref t 3.5 #f) (hashtable-ref t 'x 'none) (hashtable-size t))) (newline)
(define e (make-eq-hashtable)) (define k (list 1))
(hashtable-set! e k 1) (hashtable-set! e 'sym 2) (hashtable-update! e 'sym (lambda (x) (+ x 1)) 0)
(display (list (hashtable-ref e k #f) (hashtable-ref e (list 1) #f) (hashtable-ref e 'sym #f) (hashtable-size e))) (newline)
(define h (make-hash-table)) (hash-table-set! h "a" 1) (hash-table-update!/default h "a" (lambda (x) (+ x 10)) 0)
(display (list (hash-table-ref/default h "a" 0) (hash-table-ref h "b" (lambda () 'missing)) (hash-table-count h))) (newline)
(define v (make-eqv-hashtable)) (hashtable-set! v 2.5 'f) (hashtable-set! v 100000000000 'big)
(display (list (hashtable-ref v 2.5 #f) (hashtable-ref v 100000000000 #f))) (newline)
(define x (list 1 2 3)) (set-cdr! (cddr x) x) (define y (list 1 2 3 1 2 3)) (set-cdr! (cddr (cdddr y)) y)
(display (equal? x y)) (newline)
(define (tree n) (if (= n 0) '() (let ((s (tree (- n 1)))) (list s s s s))))
(display (equal? (tree 40) (tree 40))) (newline)
(display (eq? (string->symbol "hello") 'hello)) (newline)
(display (vector-map + #(1 2) #(10 20))) (newline)
