;; Independent retention/accounting regression; deliberately tiny budgets.
(define (limit-check name yes) (unless yes (error "History limit regression" name)))
(limit-check 'default-ring-limits
  (and (= *kill-ring-max* 60) (= *kill-ring-byte-limit* 4194304) (= *kill-ring-entry-limit* 1048576)))
(limit-check 'default-undo-limits
  (and (= *undo-limit* 8388608) (= *undo-group-limit* 200) (= *undo-change-limit* 10000)))
(set! *kill-ring* '())
(set! *kill-ring-max* 3)
(set! *kill-ring-byte-limit* 8)
(set! *kill-ring-entry-limit* 4)
(for-each push-kill '("aa" "bb" "cc" "dd" "ee"))
(limit-check 'ring-count (= (length *kill-ring*) 3))
(limit-check 'ring-bytes (= (kill-ring-bytes) 6))
(push-kill "xxxxx")
(limit-check 'oversized-copy-not-retained (= (kill-ring-bytes) 6))
(push-kill "αβ")
(limit-check 'utf8-ring-bytes (<= (kill-ring-bytes) 8))
(set! *kill-ring-entry-limit* 1)
(trim-kill-ring)
(limit-check 'entry-reduction (null? *kill-ring*))
(set! *undo-limit* 100)
(set! *undo-group-limit* 2)
(set! *undo-change-limit* 100)
(define id 987654)
(define (record-test n)
  (when (> n 0)
    (undo-boundary "retention-test")
    (record-change id 105 0 payload)
    (record-test (- n 1))))
(record-test 4)
(define h (history-of id))
(limit-check 'group-limit (= (length (history-groups h)) 2))
(limit-check 'live-bytes (= (history-actual-bytes h) 8))
(limit-check 'saved-baseline-invalidated (= (undo-history-saved-id h) -1))
;; Move the newest group to redo, then make a new edit: no dead-byte drift.
(vector-set! h 1 (list (car (undo-history-done h))))
(vector-set! h 0 (cdr (undo-history-done h)))
(record-test 1)
(limit-check 'redo-discarded (null? (undo-history-undone h)))
(limit-check 'redo-byte-accounting (= (undo-history-bytes h) 8))
(limit-check 'exact-byte-accounting (= (undo-history-bytes h) (history-actual-bytes h)))
;; Both stacks are budgeted, including redo-only history.
(vector-set! h 1 (undo-history-done h))
(vector-set! h 0 '())
(set! *undo-limit* 4)
(trim-history h)
(limit-check 'redo-byte-limit (= (undo-history-bytes h) 4))
(limit-check 'redo-group-limit (= (length (undo-history-undone h)) 1))
;; The newest group may exceed the budget; never keep it indefinitely.
(record-change id 114 0 payload)
(set! *undo-limit* 3)
(record-test 1)
(set! h (history-of id))
(limit-check 'oversized-undo-group (null? (history-groups h)))
(limit-check 'oversized-accounting (= (undo-history-bytes h) 0))
;; Further acts of that same oversized command must not create a partial undo.
(record-change id 105 0 payload)
(limit-check 'no-partial-truncated-command (null? (history-groups h)))
;; Bound metadata even for lots of tiny alternating acts in one group.
(record-change id 114 0 payload)
(set! *undo-limit* 100)
(set! *undo-change-limit* 2)
(undo-boundary "many-small-acts")
(record-change id 105 0 payload)
(record-change id 100 0 payload)
(record-change id 105 0 payload)
(set! h (history-of id))
(limit-check 'change-count-limit (<= (history-change-count h) 2))
(record-change id 114 0 payload)
(limit-check 'history-removal (not (get *undo-histories* id #f)))
(display "PASS bounded kill ring, both undo stacks, exact accounting, oversize and metadata limits\n")

(define (history-limit-test-passed) (search-history-snapshot-tests) #t)

;; Search checks need a live buffer: run after module startup, not while
;; the compiled program is being instantiated by C.
(define (search-history-snapshot-tests)
  (set! *kill-ring-entry-limit* 4)
  (tester-history-begin)
  (push-kill "aa")
  (record-change (fe-buffer-id) 105 0 payload)
  (set! *tester-search-baseline* (tester-search-state))
  (limit-check 'search-baseline (tester-search-unchanged?))
  (set! *kill-ring* (list "bb"))
  (limit-check 'search-same-size-ring-corruption (not (tester-search-unchanged?)))
  (set! *kill-ring* (list "aa"))
  (limit-check 'search-ring-restoration (tester-search-unchanged?))
  (let* ((history (current-history))
         (change (car (undo-group-changes (car (undo-history-done history))))))
    (vector-set! change 1 1)
    (limit-check 'search-history-position-corruption (not (tester-search-unchanged?))))
  (record-change (fe-buffer-id) 114 0 payload)
  (tester-history-end)
  (display "PASS search snapshots reject same-size ring and undo-record corruption\n"))
