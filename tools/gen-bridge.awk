# gen-bridge.awk -- src/bridge-functions.c from src/native.c
#
#   awk -f tools/gen-bridge.awk src/native.c > src/bridge-functions.c
#
# Every "extern TYPE name(ARGS);" of native.c whose types are int, long,
# char * (const or not) or void becomes a C function compiled Scheme can
# call (compiled/bridge.scm), under the Scheme name native.c gives it
# ({"fe-insert", wrap_fe_insert}).  Strings that C returns belong to C:
# they are copied, never freed; string arguments are copies, freed after.
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function ctype(decl,   t) {      # "const char *name" -> "char*", "long x" -> "long"
	t = decl; gsub(/const /, "", t)
	if (t ~ /\*/) return "char*"
	sub(/[ \t]+[A-Za-z_0-9]+$/, "", t)
	return trim(t)
}
/^extern / {
	line = $0
	sub(/^extern[ \t]+/, "", line); sub(/;.*$/, "", line)
	open = index(line, "(")
	head = substr(line, 1, open - 1); args = substr(line, open + 1); sub(/\)[ \t]*$/, "", args)
	name = head; sub(/^.*[ \t*]/, "", name)
	ret = substr(head, 1, length(head) - length(name)); gsub(/const /, "", ret); ret = trim(ret)
	if (ret ~ /\*/) ret = "char*"
	n = 0; ok = (ret == "int" || ret == "long" || ret == "void" || ret == "char*")
	if (trim(args) != "void" && trim(args) != "") {
		k = split(args, parts, ",")
		for (i = 1; i <= k; i++) {
			t = ctype(trim(parts[i]))
			if (t != "int" && t != "long" && t != "char*") ok = 0
			type[name, ++n] = t
		}
	}
	if (!ok) { skipped = skipped " " name; next }
	nargs[name] = n; rtype[name] = ret; order[++count] = name
	decl[name] = $0
	next
}
/^[ \t]*\{"[^"]+", wrap_[A-Za-z_0-9]+\}/ {
	s = $0; sub(/^[ \t]*\{"/, "", s); scheme = s; sub(/".*$/, "", scheme)
	c = s; sub(/^.*wrap_/, "", c); sub(/\}.*$/, "", c)
	schemename[c] = scheme
	next
}
END {
	print "/* bridge-functions.c -- GENERATED by tools/gen-bridge.awk from src/native.c."
	print " * The editor's C functions, for compiled Scheme (src/bridge.c). */"
	print "#include <stdlib.h>"
	print "#include \"bridge.h\""
	print ""
	for (j = 1; j <= count; j++) {
		f = order[j]; if (!(f in schemename)) continue
		print decl[f]
		print "static void b_" f "(bridge_in *in, bridge_out *out)"
		print "{"
		call = ""
		for (i = 1; i <= nargs[f]; i++) {
			t = type[f, i]
			if (t == "char*") print "\tchar *a" i " = bridge_string(in);"
			else print "\t" t " a" i " = (" t ") bridge_int(in);"
			call = call (i > 1 ? ", " : "") "a" i
		}
		if (rtype[f] == "void") print "\t" f "(" call ");\n\tbridge_put_nothing(out);"
		else if (rtype[f] == "char*") print "\tconst char *r = " f "(" call ");\n\tbridge_put_string(out, r);"
		else print "\tbridge_put_int(out, (long) " f "(" call "));"
		for (i = 1; i <= nargs[f]; i++) if (type[f, i] == "char*") print "\tfree(a" i ");"
		print "}"
		print ""
	}
	print "void bridge_register_editor(void)"
	print "{"
	for (j = 1; j <= count; j++) { f = order[j]; if (f in schemename) print "\tbridge_register(\"" schemename[f] "\", b_" f ");" }
	print "}"
	if (skipped != "") print "/* not generated (other types):" skipped " */"
}
