# gen-bridge-scheme.awk -- compiled/editor-functions.scm from src/native.c
#
#   awk -f tools/gen-bridge-scheme.awk src/native.c > compiled/editor-functions.scm
#
# The same functions as tools/gen-bridge.awk, declared for compiled Scheme
# with Chez's foreign-procedure: (define fe-insert (foreign-procedure ...)).
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function stype(decl,   t) {
	t = decl; gsub(/const /, "", t)
	if (t ~ /\*/) return "string"
	sub(/[ \t]+[A-Za-z_0-9]+$/, "", t); t = trim(t)
	return t
}
/^extern / {
	line = $0
	sub(/^extern[ \t]+/, "", line); sub(/;.*$/, "", line)
	open = index(line, "(")
	head = substr(line, 1, open - 1); args = substr(line, open + 1); sub(/\)[ \t]*$/, "", args)
	name = head; sub(/^.*[ \t*]/, "", name)
	ret = substr(head, 1, length(head) - length(name)); gsub(/const /, "", ret); ret = trim(ret)
	if (ret ~ /\*/) ret = "string"
	ok = (ret == "int" || ret == "long" || ret == "void" || ret == "string"); types = ""
	if (trim(args) != "void" && trim(args) != "") {
		k = split(args, parts, ",")
		for (i = 1; i <= k; i++) {
			t = stype(trim(parts[i]))
			if (t != "int" && t != "long" && t != "string") ok = 0
			types = types (i > 1 ? " " : "") t
		}
	}
	if (ok) { sig[name] = "(" types ") " ret; order[++count] = name }
	next
}
/^[ \t]*\{"[^"]+", wrap_[A-Za-z_0-9]+\}/ {
	s = $0; sub(/^[ \t]*\{"/, "", s); scheme = s; sub(/".*$/, "", scheme)
	c = s; sub(/^.*wrap_/, "", c); sub(/\}.*$/, "", c)
	schemename[c] = scheme
}
END {
	print ";;;; editor-functions.scm -- GENERATED by tools/gen-bridge-scheme.awk from"
	print ";;;; src/native.c: the C core's functions, for compiled Scheme (bridge.scm)."
	print ""
	for (j = 1; j <= count; j++) {
		f = order[j]; if (!(f in schemename)) continue
		print "(define " schemename[f] " (foreign-procedure \"" schemename[f] "\" " sig[f] "))"
	}
}
