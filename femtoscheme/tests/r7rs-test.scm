; -*- scheme -*-
; femtoscheme R7RS checks. Run: ../femtoscheme r7rs-test.scm

(define failures 0)
(define passes 0)
(define-syntax check
  (syntax-rules (=>)
    ((_ expr => expected)
     (let ((actual (guard (e (#t (list 'raised (error-object-message e)))) expr)))
       (if (equal? actual expected)
           (set! passes (+ passes 1))
           (begin (set! failures (+ failures 1))
                  (display "FAIL: ") (write 'expr)
                  (display " => ") (write actual)
                  (display ", expected ") (write expected) (newline)))))))

; reader and printer
(check '[a [b] c] => '(a (b) c))
(check (vector? '#(1 2)) => #t)
(check (with-output-to-string (lambda () (write '#(1 "x" #\a)))) => "#(1 \"x\" #\\a)")
(check (with-output-to-string (lambda () (write (list #\space #\newline #\x3bb #\null))))
       => "(#\\space #\\newline #\\λ #\\null)")
(check (list #true #false) => '(#t #f))
(check "\x41;\x3bb;" => "Aλ")
(check (string-length "a\x3bb;b") => 3)
(check #e1.0 => 1)
(check #i3 => 3.0)
(check #x-ff => -255)
(check (bytevector? #u8(1 2 3)) => #t)
(check (with-output-to-string (lambda () (write "tab\there"))) => "\"tab\\there\"")
(check #| block |# 'after => 'after)
(check (list 1 #;(ignored) 2) => '(1 2))

; binding and control
(check (let loop ((i 0) (acc '())) (if (= i 3) acc (loop (+ i 1) (cons i acc)))) => '(2 1 0))
(check (letrec* ((a 1) (b (+ a 1))) b) => 2)
(check (let-values (((a b) (values 1 2)) ((c) (values 3))) (list a b c)) => '(1 2 3))
(check (let*-values (((a) (values 1)) ((b) (values (+ a 1)))) b) => 2)
(check (call-with-values (lambda () (values 1 2)) +) => 3)
(define-values (dv1 dv2) (values 10 20))
(check (+ dv1 dv2) => 30)
(check (case 5 ((1 2) 'low) ((5) => (lambda (x) (* x 2))) (else 'other)) => 10)
(check (case 'z ((a) 1) (else => (lambda (x) x))) => 'z)
(check (do ((i 0 (+ i 1)) (s 0 (+ s i))) ((= i 4) s)) => 6)
(check (when (> 1 0) 'yes) => 'yes)
(check (unless (> 1 0) 'yes) => #f)
(define plus (case-lambda ((a) a) ((a b) (+ a b)) ((a . rest) (apply + a rest))))
(check (list (plus 1) (plus 1 2) (plus 1 2 3)) => '(1 3 6))
(check (cond ((assv 2 '((1 . a) (2 . b))) => cdr) (else 'none)) => 'b)

; continuations, dynamic-wind
(check (call/cc (lambda (k) (+ 1 (k 42)))) => 42)
(check (+ 1 (call/cc (lambda (k) 2))) => 3)
(check (let ((trail '()))
         (call/cc (lambda (k)
                    (dynamic-wind (lambda () (set! trail (cons 'in trail)))
                                  (lambda () (k 'escaped))
                                  (lambda () (set! trail (cons 'out trail))))))
         (reverse trail))
       => '(in out))
(check (call-with-current-continuation
        (lambda (return) (for-each (lambda (x) (if (negative? x) (return x))) '(1 -2 3)) 'none))
       => -2)

; exceptions
(check (guard (e ((symbol? e) (list 'sym e))) (raise 'oops)) => '(sym oops))
(check (guard (e ((string? e) e) ((error-object? e) (error-object-message e)))
         (error "bad thing" 1 2))
       => "bad thing")
(check (guard (e (#t (error-object-irritants e))) (error "bad" 1 2)) => '(1 2))
(check (with-exception-handler (lambda (e) 'handled) (lambda () (raise 'x))) => 'handled)
(check (with-exception-handler (lambda (e) 10)
         (lambda () (+ 1 (raise-continuable 'c))))
       => 11)
(check (guard (e ((error-object? e) 'caught)) (car 1)) => 'caught)
(check (guard (e (#f 'no)) (guard (e2 ((number? e2) 'inner)) (raise 'outer))) => '(raised ""))

; parameters and promises
(define p (make-parameter 10 (lambda (x) (* x 2))))
(check (p) => 20)
(check (parameterize ((p 3)) (p)) => 6)
(check (p) => 20)
(check (force (delay (+ 1 2))) => 3)
(check (let ((n 0)) (define pr (delay (begin (set! n (+ n 1)) n))) (force pr) (force pr)) => 1)
(check (force (make-promise 5)) => 5)
(check (promise? (delay 1)) => #t)
(define (stream-from n) (delay-force (stream-from (+ n 1))))
(check (force (delay-force (delay 'deep))) => 'deep)

; syntax-rules
(define-syntax swap!
  (syntax-rules () ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp)))))
(check (let ((tmp 1) (other 2)) (swap! tmp other) (list tmp other)) => '(2 1))
(define-syntax my-or
  (syntax-rules () ((_) #f) ((_ e) e) ((_ e r ...) (let ((t e)) (if t t (my-or r ...))))))
(check (let ((t 5)) (my-or #f t)) => 5)
(define-syntax my-let*
  (syntax-rules ()
    ((_ () body ...) (let () body ...))
    ((_ ((x v) rest ...) body ...) (let ((x v)) (my-let* (rest ...) body ...)))))
(check (my-let* ((a 1) (b (+ a 1))) (* a b)) => 2)
(define-syntax nest
  (syntax-rules () ((_ (a b ...) ...) '((a ...) (b ... ...)))))
(check (nest (1 2 3) (4 5)) => '((1 4) (2 3 5)))
(define-syntax tail-pat
  (syntax-rules () ((_ a ... z) '(z a ...))))
(check (tail-pat 1 2 3) => '(3 1 2))
(define-syntax vec-pat
  (syntax-rules () ((_ #(a ...)) (+ a ...))))
(check (vec-pat #(1 2 3)) => 6)
(define-syntax lit
  (syntax-rules (to) ((_ a to b) (list a b)) ((_ a b c) 'no-literal)))
(check (lit 1 to 2) => '(1 2))
(check (lit 1 from 2) => 'no-literal)
(define-syntax my-ellipsis
  (syntax-rules ::: () ((_ x :::) (list x :::))))
(check (my-ellipsis 1 2) => '(1 2))
(define-syntax escaped
  (syntax-rules () ((_ x) '(x (... ...)))))
(check (escaped 1) => '(1 ...))
(check (let ((x 1)) (define-syntax inc! (syntax-rules () ((_ v) (set! v (+ v 1))))) (inc! x) x) => 2)
(check (let-syntax ((double (syntax-rules () ((_ x) (* 2 x))))) (double 4)) => 8)
(check (letrec-syntax ((ev? (syntax-rules () ((_ n) (even? n))))) (ev? 4)) => #t)
(define-syntax while-loop
  (syntax-rules ()
    ((_ cond body ...) (let lp () (when cond body ... (lp))))))
(check (let ((i 0) (lp 'mine)) (while-loop (< i 3) (set! i (+ i 1))) (list i lp)) => '(3 mine))

; numbers
(check (list (exact? 1) (inexact? 1.5) (integer? 2.0) (exact-integer? 2.0)) => '(#t #t #t #f))
(check (list (floor 2.5) (ceiling 2.5) (round 2.5) (round 3.5) (truncate -2.5)) => '(2.0 3.0 2.0 4.0 -2.0))
(check (list (floor -2.5) (round -2.5) (floor 7)) => '(-3.0 -2.0 7))
(check (list (quotient 7 2) (remainder -7 2) (modulo -7 2)) => '(3 -1 1))
(check (call-with-values (lambda () (floor/ -7 2)) list) => '(-4 1))
(check (list (gcd 12 18) (lcm 4 6) (abs -5) (min 3 1 2) (max 3 1 2)) => '(6 12 5 1 3))
(check (list (expt 2 10) (expt 2 -1) (square 5) (exact (floor 2.7))) => '(1024 0.5 25 2))
(check (call-with-values (lambda () (exact-integer-sqrt 17)) list) => '(4 1))
(check (list (number->string 255 16) (string->number "ff" 16) (string->number "1e2")) => '("ff" 255 100.0))
(check (exact->inexact 1) => 1.0)
(check (list (nan? +nan.0) (infinite? -inf.0) (finite? 1.0)) => '(#t #t #t))
(check (exact (atan 1 0)) => (list (quote raised) "exact: no exact integer for"))

; booleans, symbols, chars
(check (list (boolean=? #t #t) (symbol=? 'a 'a 'a) (eq? 'abc (string->symbol "abc"))) => '(#t #t #t))
(check (list (char->integer #\A) (integer->char 955) (char-upcase #\a) (char-downcase #\Λ)) => '(65 #\λ #\A #\λ))
(check (list (char<? #\a #\b #\c) (char-ci=? #\a #\A) (char-numeric? #\7) (digit-value #\7)) => '(#t #t #t 7))
(check (list (char-whitespace? #\tab) (char-upper-case? #\A) (char-lower-case? #\A) (char-alphabetic? #\é)) => '(#t #t #f #t))

; strings (indexes count characters)
(check (string-ref "héllo" 1) => #\é)
(check (substring "héllo wörld" 6 11) => "wörld")
(check (substring "héllo" 2) => "llo")
(check (string-append "a" "β" "c") => "aβc")
(check (string->list "aβc") => '(#\a #\β #\c))
(check (list->string (list #\x #\y)) => "xy")
(check (make-string 3 #\z) => "zzz")
(check (string-upcase "ábc") => "ÁBC")
(check (list (string=? "a" "a" "a") (string<? "a" "b") (string-ci=? "Ab" "aB")) => '(#t #t #t))
(check (string-map char-upcase "abc") => "ABC")
(check (let ((n 0)) (string-for-each (lambda (c) (set! n (+ n 1))) "αβγ") n) => 3)
(check (string-copy "hello" 1 3) => "el")
(check (string-contains "héllo world" "wor") => 6)
(check (string-index "abc" #\c) => 2)
(check (list (string-prefix? "he" "hello") (string-suffix? "lo" "hello")) => '(#t #t))
(check (string-join (string-split "a b c") "-") => "a-b-c")
(check (string-trim-both "  x  ") => "x")
(check (string->vector "ab") => #(#\a #\b))
(check (utf8->string (string->utf8 "λx")) => "λx")
(check (bytevector-length (string->utf8 "λ")) => 2)
(check (symbol->string 'abc) => "abc")
(check (string->number "abc") => #f)

; lists and vectors
(check (list (memv 2 '(1 2 3)) (member "b" '("a" "b")) (assoc 2.0 '((1 . a) (2 . b)) =)) => '((2 3) ("b") (2 . b)))
(check (list-copy '(1 2 3)) => '(1 2 3))
(check (make-list 2 'x) => '(x x))
(check (iota 4 1) => '(1 2 3 4))
(check (fold + 0 '(1 2 3)) => 6)
(check (fold cons '() '(1 2 3)) => '(3 2 1))
(check (fold-left list '() '(1 2)) => '((() 1) 2))
(check (fold-right cons '() '(1 2)) => '(1 2))
(check (reduce max 0 '(3 9 2)) => 9)
(check (delete 2 '(1 2 3 2)) => '(1 3))
(check (call-with-values (lambda () (partition odd? '(1 2 3 4))) list) => '((1 3) (2 4)))
(check (filter-map (lambda (x) (and (odd? x) (* x x))) '(1 2 3)) => '(1 9))
(check (append-map (lambda (x) (list x x)) '(1 2)) => '(1 1 2 2))
(check (list (find even? '(1 4 5)) (list-index even? '(1 3 4)) (last '(1 2 3))) => '(4 2 3))
(check (sort '(3 1 2) <) => '(1 2 3))
(check (sort #(3 1 2) <) => #(1 2 3))
(check (let ((l (list 1 2 3))) (list-set! l 1 'x) l) => '(1 x 3))
(check (list (vector-ref #(1 2 3) 1) (vector-length #(1 2)) (make-vector 2 'a)) => '(2 2 #(a a)))
(check (vector->list #(1 2 3 4) 1 3) => '(2 3))
(check (vector-copy #(1 2 3) 1) => #(2 3))
(check (let ((v (vector 1 2 3 4 5))) (vector-copy! v 0 #(a b)) v) => #(a b 3 4 5))
(check (vector-append #(1) #(2 3)) => #(1 2 3))
(check (vector-map + #(1 2) #(10 20)) => #(11 22))
(check (let ((v (make-vector 3 0))) (vector-fill! v 7) v) => #(7 7 7))
(check (map + '(1 2) '(10 20)) => '(11 22))
(check (apply max 1 '(5 3)) => 5)
(check (assq 'b '((a 1) (b 2))) => '(b 2))
(check (list? '(1 2)) => #t)
(check (procedure? car) => #t)

; ports
(check (let ((p (open-input-string "line one\nline two")))
         (list (read-line p) (read-char p) (peek-char p) (read-line p) (eof-object? (read-line p))))
       => '("line one" #\l #\i "ine two" #t))
(check (read (open-input-string "(a . b)")) => '(a . b))
(check (read (open-input-string "8")) => 8)
(check (read (open-input-string "x")) => 'x)
(check (eof-object? (read (open-input-string "   "))) => #t)
(check (let ((p (open-output-string))) (write 'x p) (display " y" p) (get-output-string p)) => "x y")
(check (with-output-to-string (lambda () (display "a") (write-char #\b) (write-string "cd") (newline))) => "abcd\n")
(check (call-with-output-string (lambda (port) (display 42 port))) => "42")
(check (read-string 3 (open-input-string "abcdef")) => "abc")
(check (with-output-to-string (lambda () (display '(1 "two" #\3)))) => "(1 two 3)")

(display (string passes " passed, " failures " failed"))
(newline)
(if (> failures 0) (exit 1))
