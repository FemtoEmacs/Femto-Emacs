; -*- scheme -*-
; femtoscheme: the R7RS-small layer over the femtolisp core.
; Loaded into the boot image after system.scm and compiler.scm.
;
; Deliberate differences from R7RS-small, documented in README.md:
;  - syntax-rules is not fully hygienic. Identifiers a template binds
;    (lambda, let, let*, letrec, letrec*, named let, do) are renamed, so
;    the classic capture problems are avoided; free identifiers in a
;    template refer to whatever is visible where the macro is used.
;  - call/cc captures escaping continuations only (early exit, generators
;    built on re-entry are not supported).
;  - no exact rationals: (/ 1 2) is 0.5. Integers are exact.
;  - strings are immutable UTF-8; string-set! and string-fill! signal an
;    error. Indexes count characters, not bytes.

; syntax-rules -----------------------------------------------------------------

(define %sr-ellipsis-tag (list 'ellipsis-match))
(define (%sr-multi? x) (and (pair? x) (eq? (car x) %sr-ellipsis-tag)))

(define (%sr-pattern-vars pat lits ell)
  (cond ((symbol? pat)
         (if (or (memq pat lits) (eq? pat '_) (eq? pat ell)) () (list pat)))
        ((pair? pat) (append (%sr-pattern-vars (car pat) lits ell)
                             (%sr-pattern-vars (cdr pat) lits ell)))
        ((vector? pat) (%sr-pattern-vars (vector->list pat) lits ell))
        (else ())))

; Number of pairs in a (possibly improper) list.
(define (%sr-pairs x)
  (let loop ((x x) (n 0)) (if (pair? x) (loop (cdr x) (+ n 1)) n)))

(define (%sr-match pat form lits ell binds)
  (cond ((not binds) #f)
        ((symbol? pat)
         (cond ((memq pat lits) (and (eq? pat form) binds))
               ((eq? pat '_) binds)
               (else (cons (cons pat form) binds))))
        ((pair? pat)
         (if (and (pair? (cdr pat)) (eq? (cadr pat) ell))
             ; (p ... . rest): repeat p, then the fixed rest matches the tail
             (let* ((rest  (cddr pat))
                    (extra (- (%sr-pairs form) (%sr-pairs rest))))
               (and (>= extra 0)
                    (let loop ((form form) (k extra) (matches ()))
                      (if (> k 0)
                          (let ((m (%sr-match (car pat) (car form) lits ell ())))
                            (and m (loop (cdr form) (- k 1) (cons m matches))))
                          (let ((matches (reverse! matches)))
                            (%sr-match rest form lits ell
                                       (append
                                        (map (lambda (v)
                                               (cons v (cons %sr-ellipsis-tag
                                                             (map (lambda (m) (cdr (assq v m)))
                                                                  matches))))
                                             (%sr-pattern-vars (car pat) lits ell))
                                        binds)))))))
             (and (pair? form)
                  (%sr-match (cdr pat) (cdr form) lits ell
                             (%sr-match (car pat) (car form) lits ell binds)))))
        ((null? pat) (and (null? form) binds))
        ((vector? pat)
         (and (vector? form)
              (%sr-match (vector->list pat) (vector->list form) lits ell binds)))
        (else (and (equal? pat form) binds))))

; Template variables with ellipsis bindings that drive one repetition.
(define (%sr-multi-vars tmpl binds)
  (cond ((symbol? tmpl)
         (let ((b (assq tmpl binds))) (if (and b (%sr-multi? (cdr b))) (list tmpl) ())))
        ((pair? tmpl) (append (%sr-multi-vars (car tmpl) binds)
                              (%sr-multi-vars (cdr tmpl) binds)))
        ((vector? tmpl) (%sr-multi-vars (vector->list tmpl) binds))
        (else ())))

(define (%sr-repeat sub binds ell rename depth)
  (let ((vars (delete-duplicates (%sr-multi-vars sub binds))))
    (if (null? vars)
        (error "syntax-rules: no pattern variable to repeat in" sub))
    (let loop ((lists (map (lambda (v) (cddr (assq v binds))) vars))
               (out ()))
      (if (any null? lists)
          (apply append (reverse! out))
          (let ((binds (append (map cons vars (map car lists)) binds)))
            (loop (map cdr lists)
                  (cons (if (> depth 1)
                            (%sr-repeat sub binds ell rename (- depth 1))
                            (list (%sr-expand sub binds ell rename)))
                        out)))))))

(define (%sr-expand tmpl binds ell rename)
  (cond ((symbol? tmpl)
         (let ((b (assq tmpl binds)))
           (cond ((not b) (rename tmpl))
                 ((%sr-multi? (cdr b))
                  (error "syntax-rules: pattern variable used without ellipsis:" tmpl))
                 (else (cdr b)))))
        ((pair? tmpl)
         (cond ((and (eq? (car tmpl) ell) (pair? (cdr tmpl)))
                ; (... template): ellipses inside are literal
                (%sr-expand (cadr tmpl) binds (list 'no-ellipsis) rename))
               ((and (pair? (cdr tmpl)) (eq? (cadr tmpl) ell))
                (let loop ((rest (cddr tmpl)) (depth 1))
                  (if (and (pair? rest) (eq? (car rest) ell))
                      (loop (cdr rest) (+ depth 1))
                      (append (%sr-repeat (car tmpl) binds ell rename depth)
                              (%sr-expand rest binds ell rename)))))
               (else (cons (%sr-expand (car tmpl) binds ell rename)
                           (%sr-expand (cdr tmpl) binds ell rename)))))
        ((vector? tmpl)
         (list->vector (%sr-expand (vector->list tmpl) binds ell rename)))
        (else tmpl)))

; Symbols a template binds itself; these are renamed at each expansion.
(define (%sr-binders tmpl skip)
  (define (formals f)
    (cond ((symbol? f) (list f))
          ((pair? f) (append (formals (car f)) (formals (cdr f))))
          (else ())))
  (define (bindings bs) (if (list? bs) (map (lambda (b) (if (pair? b) (car b) b)) bs) ()))
  (define (walk t)
    (if (not (pair? t)) ()
        (append
         (case (car t)
           ((lambda) (if (pair? (cdr t)) (formals (cadr t)) ()))
           ((let)
            (cond ((and (pair? (cdr t)) (symbol? (cadr t)) (pair? (cddr t)))
                   (cons (cadr t) (bindings (caddr t))))
                  ((pair? (cdr t)) (bindings (cadr t)))
                  (else ())))
           ((let* letrec letrec* do) (if (pair? (cdr t)) (bindings (cadr t)) ()))
           (else ()))
         (apply append (map walk (to-proper t))))))
  (filter (lambda (s) (and (symbol? s) (not (memq s skip))))
          (delete-duplicates (walk tmpl))))

(define (%make-syntax-rules spec)
  (let* ((custom (symbol? (car spec)))
         (ell    (if custom (car spec) '...))
         (lits   (if custom (cadr spec) (car spec)))
         (rules  (if custom (cddr spec) (cdr spec)))
         (prepared
          (map (lambda (rule)
                 (let* ((pattern (cdar rule))   ; the keyword position is ignored
                        (tmpl    (cadr rule))
                        (pvars   (%sr-pattern-vars pattern lits ell)))
                   (list pattern tmpl (%sr-binders tmpl (cons ell (append lits pvars))))))
               rules))
         (name (if (and (pair? rules) (pair? (caar rules))) (caaar rules) 'syntax-rules)))
    (lambda args
      (let loop ((rs prepared))
        (if (null? rs)
            (error "no syntax rule matches " (cons name args))
            (let ((binds (%sr-match (caar rs) args lits ell ())))
              (if binds
                  (let ((renames (map (lambda (s) (cons s (gensym))) (caddr (car rs)))))
                    (%sr-expand (cadr (car rs)) binds ell
                                (lambda (s) (let ((r (assq s renames))) (if r (cdr r) s)))))
                  (loop (cdr rs)))))))))

(define-macro (syntax-rules . spec) `(%make-syntax-rules ',spec))
(define-macro (er-macro-transformer f) f)

(define-macro (define-syntax name transformer)
  `(begin (set-syntax! ',name ,transformer) ',name))

(define-macro (letrec-syntax binds . body) `(let-syntax ,binds ,@body))

; control ------------------------------------------------------------------

(define (procedure? x) (function? x))

; case with => clauses (R7RS); other clauses as in femtolisp's case
(define-macro (case key . clauses)
  (define (test g v)
    (cond ((eq? v 'else) 'else)
          ((null? v)     #f)
          ((atom? v)     `(eqv? ,g ',v))
          ((every symbol? v) `(memq ,g ',v))
          (else          `(memv ,g ',v))))
  (let ((g (gensym)))
    `(let ((,g ,key))
       (cond ,.(map (lambda (clause)
                      (cons (test g (car clause))
                            (if (and (pair? (cdr clause)) (eq? (cadr clause) '=>))
                                `((,(caddr clause) ,g))
                                (cdr clause))))
                    clauses)))))

(define-macro (letrec* binds . body) `(letrec ,binds ,@body))

; Escaping continuations. A continuation called after its extent has
; ended reports an error instead of resuming.
(define %continuation-tag (list 'continuation))

(define (call-with-current-continuation f)
  (let* ((id (list 'k))
         (active #t)
         (k (lambda vals
              (if active
                  (raise (list %continuation-tag id vals))
                  (error "call/cc: this continuation can no longer be resumed (femtoscheme supports escaping continuations only)")))))
    (prog1
     (trycatch (f k)
               (lambda (e)
                 (if (and (pair? e) (eq? (car e) %continuation-tag) (eq? (cadr e) id))
                     (begin (set! active #f)
                            (apply values (caddr e)))
                     (begin (set! active #f) (raise e)))))
     (set! active #f))))
(define call/cc call-with-current-continuation)

; Escapes and errors both unwind through raise, so after always runs.
(define (dynamic-wind before thunk after)
  (before)
  (let ((result (trycatch (thunk)
                          (lambda (e) (after) (raise e)))))
    (after)
    result))

(define-macro (let-values bindings . body)
  (if (null? bindings)
      `(let () ,@body)
      `(call-with-values (lambda () ,(cadar bindings))
         (lambda ,(caar bindings)
           (let-values ,(cdr bindings) ,@body)))))
(define-macro (let*-values bindings . body) `(let-values ,bindings ,@body))

(define-macro (define-values formals expr)
  (let ((vars (to-proper formals))
        (tmps (map (lambda (x) (gensym)) (to-proper formals))))
    (define (rebuild f ts)
      (cond ((null? f) ())
            ((symbol? f) (car ts))
            (else (cons (car ts) (rebuild (cdr f) (cdr ts))))))
    `(begin
       ,@(map (lambda (v) `(define ,v #f)) vars)
       (call-with-values (lambda () ,expr)
         (lambda ,(rebuild formals tmps)
           ,@(map (lambda (v t) `(set! ,v ,t)) vars tmps)))
       (void))))

(define-macro (case-lambda . clauses)
  (let ((args (gensym)) (n (gensym)))
    (define (arity-test formals)
      (let ((k (%sr-pairs formals)))
        (if (null? (cdr (last-pair (cons #f formals))))
            `(= ,n ,k)
            `(>= ,n ,k))))
    `(lambda ,args
       (let ((,n (length ,args)))
         (cond ,@(map (lambda (c)
                        `(,(arity-test (car c)) (apply (lambda ,(car c) ,@(cdr c)) ,args)))
                      clauses)
               (else (error "case-lambda: no clause accepts " ,n " arguments")))))))

; Parameters: calling with %parameter-set stores a converted value.
(define %parameter-set (list 'parameter-set))
(define (make-parameter value (converter identity))
  (let ((value (converter value)))
    (lambda args
      (cond ((null? args) value)
            ((eq? (car args) %parameter-set) (set! value (cadr args)) value)
            ((eq? (car args) %parameter-convert) (converter (cadr args)))
            (else (error "parameter objects take no arguments"))))))
(define %parameter-convert (list 'parameter-convert))

(define-macro (parameterize bindings . body)
  (let ((ps (map (lambda (b) (gensym)) bindings))
        (news (map (lambda (b) (gensym)) bindings))
        (olds (map (lambda (b) (gensym)) bindings)))
    `(let (,@(map (lambda (p b) `(,p ,(car b))) ps bindings))
       (let (,@(map (lambda (nv p b) `(,nv (,p %parameter-convert ,(cadr b)))) news ps bindings)
             ,@(map (lambda (o p) `(,o (,p))) olds ps))
         (dynamic-wind
          (lambda () ,@(map (lambda (p nv) `(,p %parameter-set ,nv)) ps news))
          (lambda () ,@body)
          (lambda () ,@(map (lambda (p o) `(,p %parameter-set ,o)) ps olds)))))))

; Promises (SRFI 45, as R7RS delay, delay-force and force)
(define %promise-tag (list 'promise))
(define (%make-promise done value) (list %promise-tag (cons done value)))
(define (promise? x) (and (pair? x) (eq? (car x) %promise-tag)))
(define (make-promise x) (if (promise? x) x (%make-promise #t x)))
(define-macro (delay-force expr) `(%make-promise #f (lambda () ,expr)))
(define-macro (delay expr) `(delay-force (make-promise ,expr)))
(define (force p)
  (if (not (promise? p)) p
      (let ((box (cadr p)))
        (if (car box) (cdr box)
            (let* ((p2 (make-promise ((cdr box))))
                   (box (cadr p)))          ; forcing may have finished p
              (if (not (car box))
                  (let ((box2 (cadr p2)))
                    (set-car! box (car box2))
                    (set-cdr! box (cdr box2))
                    (set-car! (cdr p2) box)))
              (force p))))))

; Exceptions ---------------------------------------------------------------
; femtolisp raises lists such as (error "message" irritant ...),
; (type-error ...) or (unbound-error name); any value can be raised.

(define %error-kinds '(error type-error bounds-error unbound-error arg-error
                       divide-error parse-error io-error key-error memory-error
                       enumeration-error load-error assert-failed))

(define (error-object? e)
  (and (pair? e) (memq (car e) %error-kinds) #t))

(define (%exception->string e)
  (let ((b (buffer)))
    (with-output-to b (print-exception e))
    (string.trim (io.tostring! b) "" " \n")))

(define (error-object-message e)
  (cond ((and (pair? e) (eq? (car e) 'error) (pair? (cdr e)) (string? (cadr e)))
         (cadr e))
        ((error-object? e) (%exception->string e))
        (else "")))

(define (error-object-irritants e)
  (if (and (pair? e) (eq? (car e) 'error) (pair? (cdr e)) (string? (cadr e)))
      (cddr e)
      ()))

(define (read-error? e) (and (pair? e) (eq? (car e) 'parse-error)))
(define (file-error? e) (and (pair? e) (eq? (car e) 'io-error)))
(define (error-message e)
  (if (error-object? e) (%exception->string e)
      (string "uncaught exception: " (%write-string e))))

; Handlers installed by with-exception-handler, innermost first.
(define %handlers ())

(define (raise-continuable obj)
  (if (null? %handlers)
      (raise obj)
      (let ((h (car %handlers)) (saved %handlers))
        (set! %handlers (cdr %handlers))
        (prog1 (trycatch (h obj) (lambda (e) (set! %handlers saved) (raise e)))
               (set! %handlers saved)))))

; raise and errors from builtins unwind to the handler: when it returns,
; with-exception-handler returns its value.
(define (with-exception-handler handler thunk)
  (let ((saved %handlers))
    (set! %handlers (cons handler saved))
    (prog1
     (trycatch (thunk)
               (lambda (e)
                 (set! %handlers saved)
                 (if (and (pair? e) (eq? (car e) %continuation-tag))
                     (raise e)
                     (handler e))))
     (set! %handlers saved))))

(define-macro (guard spec . body)
  (let ((var (car spec)) (clauses (cdr spec)))
    `(trycatch (begin ,@body)
               (lambda (,var)
                 (if (and (pair? ,var) (eq? (car ,var) %continuation-tag))
                     (raise ,var)
                     (cond ,@clauses
                           (else (raise ,var))))))))

(define (emergency-exit (code 0)) (exit code))
(define (features) '(r7rs femtoscheme full-unicode))

; numbers --------------------------------------------------------------------
; femtolisp integers are exact; flonums are inexact. There are no rationals.

; Builtins: exact-integer?, %truncate (exact result), %log, %atan.
(define (%exact-integer? x) (exact-integer? x))
(define (integer? x) (and (number? x) (integer-valued? x)))
(define (rational? x) (and (number? x) (not (nan? x)) (not (infinite? x))))
(define (real? x) (number? x))
(define (complex? x) (number? x))
(define (exact? x)
  (if (number? x) (%exact-integer? x) (error "exact?: not a number:" x)))
(define (inexact? x)
  (if (number? x) (not (%exact-integer? x)) (error "inexact?: not a number:" x)))
(define (exact-rational? x) (exact-integer? x))
(define (exact-nonnegative-integer? x) (and (exact-integer? x) (>= x 0)))
(define (infinite? x) (and (number? x) (or (= x +inf.0) (= x -inf.0))))
(define (finite? x) (and (number? x) (not (nan? x)) (not (infinite? x))))

(define (inexact x) (double x))
(define (exact x)
  (cond ((%exact-integer? x) x)
        ((and (finite? x) (integer-valued? x)) (%truncate x))
        (else (error "exact: no exact integer for" x))))
(define exact->inexact inexact)
(define inexact->exact exact)

(define (truncate x) (if (%exact-integer? x) x (double (%truncate x))))
(define (floor x)
  (if (or (%exact-integer? x) (not (finite? x))) x
      (let ((t (truncate x))) (if (> t x) (- t 1.0) t))))
(define (ceiling x)
  (if (or (%exact-integer? x) (not (finite? x))) x
      (let ((t (truncate x))) (if (< t x) (+ t 1.0) t))))
(define (round x)          ; to even, as R7RS requires
  (if (or (%exact-integer? x) (not (finite? x))) x
      (let* ((f (floor x)) (d (- x f)))
        (cond ((< d 0.5) f)
              ((> d 0.5) (+ f 1.0))
              ((even? (exact f)) f)
              (else (+ f 1.0))))))

(define (quotient n d) (div0 n d))
(define (remainder n d) (mod0 n d))
(define (modulo n d) (mod n d))
(define (truncate-quotient n d) (div0 n d))
(define (truncate-remainder n d) (mod0 n d))
(define (truncate/ n d) (values (div0 n d) (mod0 n d)))
(define (floor-quotient n d) (div n d))
(define (floor-remainder n d) (mod n d))
(define (floor/ n d) (values (div n d) (mod n d)))

(define (gcd . ns)
  (define (g a b) (if (= b 0) (abs a) (g b (remainder a b))))
  (foldl (lambda (n acc) (g n acc)) 0 ns))
(define (lcm . ns)
  (foldl (lambda (n acc)
           (if (or (= n 0) (= acc 0)) 0 (abs (quotient (* n acc) (gcd n acc)))))
         1 ns))
(define (numerator x) x)
(define (denominator x) (if (exact? x) 1 1.0))

(define (square x) (* x x))
(define (cube x) (* x x x))
(define (expt base power)
  (cond ((and (%exact-integer? power) (>= power 0) (%exact-integer? base))
         (let loop ((b base) (e power) (acc 1))
           (cond ((= e 0) acc)
                 ((odd? e) (loop (* b b) (div0 e 2) (* acc b)))
                 (else (loop (* b b) (div0 e 2) acc)))))
        ((and (%exact-integer? power) (< power 0))
         (/ 1.0 (expt base (- power))))
        ((= base 0) (if (= power 0) 1 0.0))
        (else (exp (* power (log base))))))
(define (exact-integer-sqrt n)
  (let ((s (exact (floor (sqrt n)))))
    (let loop ((s s))
      (cond ((> (* s s) n) (loop (- s 1)))
            ((<= (* (+ s 1) (+ s 1)) n) (loop (+ s 1)))
            (else (values s (- n (* s s))))))))

(define (log z (base #f)) (if base (/ (%log z) (%log base)) (%log z)))
(define pi (* 4 (%atan 1)))
(define (atan y (x #f))
  (if (not x) (%atan y)
      (cond ((> x 0) (%atan (/ y x)))
            ((< x 0) (if (>= y 0) (+ (%atan (/ y x)) pi) (- (%atan (/ y x)) pi)))
            ((> y 0) (/ pi 2))
            ((< y 0) (- (/ pi 2)))
            (else 0.0))))

(define (boolean=? a b . rest)
  (and (eq? a b) (or (null? rest) (apply boolean=? b rest))))

; characters ---------------------------------------------------------------

(define (char->integer c) (fixnum c))
(define (integer->char n) (wchar n))
(define (%char-compare name cmp fold)
  (lambda (a b . rest)
    (let loop ((a a) (b b) (rest rest))
      (and (cmp (fixnum (fold a)) (fixnum (fold b)))
           (or (null? rest) (loop b (car rest) (cdr rest)))))))
(define char=?  (%char-compare 'char=?  =  identity))
(define char<?  (%char-compare 'char<?  <  identity))
(define char>?  (%char-compare 'char>?  >  identity))
(define char<=? (%char-compare 'char<=? <= identity))
(define char>=? (%char-compare 'char>=? >= identity))
(define char-ci=?  (%char-compare 'char-ci=?  =  char.downcase))
(define char-ci<?  (%char-compare 'char-ci<?  <  char.downcase))
(define char-ci>?  (%char-compare 'char-ci>?  >  char.downcase))
(define char-ci<=? (%char-compare 'char-ci<=? <= char.downcase))
(define char-ci>=? (%char-compare 'char-ci>=? >= char.downcase))
(define (char-upcase c) (char.upcase c))
(define (char-downcase c) (char.downcase c))
(define (char-foldcase c) (char.downcase c))
(define (char-numeric? c) (and (char>=? c #\0) (char<=? c #\9)))
(define (digit-value c) (and (char-numeric? c) (- (fixnum c) 48)))
(define (char-whitespace? c)
  (and (memv (fixnum c) '(9 10 11 12 13 32 160 5760 8232 8233 8239 8287 12288)) #t))
(define (char-upper-case? c) (and (char-alphabetic? c) (not (eqv? c (char.downcase c)))))
(define (char-lower-case? c) (and (char-alphabetic? c) (not (eqv? c (char.upcase c)))))

; strings: immutable UTF-8, indexed by character ---------------------------

(define (string-length s) (string.count s))
(define (%offset s k)
  (if (or (< k 0) (> k (string.count s)))
      (raise (list 'bounds-error 'string s k))
      (string.inc s 0 k)))
(define (string-ref s k)
  (if (or (< k 0) (>= k (string.count s)))
      (raise (list 'bounds-error 'string-ref s k))
      (string.char s (string.inc s 0 k))))
(define (substring s start (end #f))
  (let ((a (%offset s start)))
    (string.sub s a (if end (string.inc s a (- end start)) (sizeof s)))))
(define (string-copy s (start 0) (end #f)) (substring s start end))
(define (string-append . strings) (apply string strings))
(define (make-string k (c #\space)) (if (= k 0) "" (string.rep (string c) k)))
(define (string->list s (start 0) (end #f))
  (let ((s (substring s start end)))
    (let loop ((i 0) (acc ()))
      (if (>= i (sizeof s)) (reverse! acc)
          (loop (string.inc s i) (cons (string.char s i) acc))))))
(define (list->string l) (if (null? l) "" (apply string l)))
(define (string->vector s (start 0) (end #f)) (list->vector (string->list s start end)))
(define (vector->string v (start 0) (end #f)) (list->string (vector->list v start end)))
(define (string-map f s . more)
  (list->string (apply map f (string->list s) (map string->list more))))
(define (string-for-each f s . more)
  (apply for-each f (string->list s) (map string->list more)))
(define (string-count s pred) (count pred (string->list s)))
(define (string-set! s k c)
  (error "string-set!: femtoscheme strings are immutable; build a new string"))
(define (string-fill! s c)
  (error "string-fill!: femtoscheme strings are immutable; build a new string"))
(define (string-copy! . args)
  (error "string-copy!: femtoscheme strings are immutable; build a new string"))

(define (%string-compare cmp fold)
  (lambda (a b . rest)
    (let loop ((a a) (b b) (rest rest))
      (and (cmp (compare (fold a) (fold b)) 0)
           (or (null? rest) (loop b (car rest) (cdr rest)))))))
(define string=?  (%string-compare =  identity))
(define string<?  (%string-compare <  identity))
(define string>?  (%string-compare >  identity))
(define string<=? (%string-compare <= identity))
(define string>=? (%string-compare >= identity))
(define (string-upcase s) (string.map char.upcase s))
(define (string-downcase s) (string.map char.downcase s))
(define (string-foldcase s) (string.map char.downcase s))
(define string-ci=?  (%string-compare =  string-foldcase))
(define string-ci<?  (%string-compare <  string-foldcase))
(define string-ci>?  (%string-compare >  string-foldcase))
(define string-ci<=? (%string-compare <= string-foldcase))
(define string-ci>=? (%string-compare >= string-foldcase))

; Handy for editor scripts (SRFI 13 and 130 names).
(define (string-null? s) (= (sizeof s) 0))
(define (string-index s pred (start 0))
  (let ((pred (if (char? pred) (lambda (c) (eqv? c pred)) pred)))
    (let loop ((i start) (cs (string->list s start)))
      (cond ((null? cs) #f)
            ((pred (car cs)) i)
            (else (loop (+ i 1) (cdr cs)))))))
(define (string-contains s pattern (start 0))
  (let ((found (string.find s pattern (%offset s start))))
    (and found (string.count s 0 found))))
(define (string-prefix? prefix s)
  (and (<= (sizeof prefix) (sizeof s)) (equal? prefix (string.sub s 0 (sizeof prefix)))))
(define (string-suffix? suffix s)
  (and (<= (sizeof suffix) (sizeof s))
       (equal? suffix (string.sub s (- (sizeof s) (sizeof suffix)) (sizeof s)))))
(define (string-split s (delimiters " ")) (string.split s delimiters))
(define (string-join strings (separator " ")) (string.join strings separator))
(define (string-trim s) (string.trim s " \t\n\r" ""))
(define (string-trim-right s) (string.trim s "" " \t\n\r"))
(define (string-trim-both s) (string.trim s " \t\n\r" " \t\n\r"))
(define (string-reverse s) (string.reverse s))

(define (string->symbol s) (symbol s))
(define (symbol->string s) (string s))
(define (string->uninterned-symbol s) (gensym))
(define (symbol=? a b . rest)
  (and (eq? a b) (or (null? rest) (apply symbol=? b rest))))

(define (string->utf8 s)
  (let ((b (buffer)))
    (io.write b s)
    (io.seek b 0)
    (if (= (sizeof s) 0) (array 'uint8)
        (io.read b `(array uint8 ,(sizeof s))))))
(define (utf8->string bv)
  (let ((b (buffer)))
    (io.write b bv)
    (io.tostring! b)))

; lists --------------------------------------------------------------------

(define (member item lst (same? equal?))
  (cond ((atom? lst) #f)
        ((same? item (car lst)) lst)
        (else (member item (cdr lst) same?))))
(define (assoc item lst (same? equal?))
  (cond ((atom? lst) #f)
        ((same? item (caar lst)) (car lst))
        (else (assoc item (cdr lst) same?))))
(define (list-copy l) (if (pair? l) (cons (car l) (list-copy (cdr l))) l))
(define (make-list n (fill #f))
  (let loop ((n n) (acc ())) (if (<= n 0) acc (loop (- n 1) (cons fill acc)))))
(define (list-set! l k v) (set-car! (list-tail l k) v))
(define (iota n (start 0) (step 1))
  (let loop ((i (- n 1)) (acc ()))
    (if (< i 0) acc (loop (- i 1) (cons (+ start (* i step)) acc)))))
(define (first l) (car l))
(define (second l) (cadr l))
(define (third l) (caddr l))
(define (last l) (car (last-pair l)))
(define (take l k) (list-head l k))
(define (drop l k) (list-tail l k))
(define (fold kons knil lst . lsts)
  (if (null? lsts)
      (let loop ((acc knil) (l lst))
        (if (pair? l) (loop (kons (car l) acc) (cdr l)) acc))
      (let loop ((acc knil) (ls (cons lst lsts)))
        (if (every pair? ls)
            (loop (apply kons (append (map car ls) (list acc))) (map cdr ls))
            acc))))
(define (fold-left f acc lst) (foldl (lambda (x a) (f a x)) acc lst))
(define (fold-right f acc lst) (foldr f acc lst))
(define (reduce f ridentity lst)
  (if (null? lst) ridentity (fold f (car lst) (cdr lst))))
(define (delete x lst (same? equal?)) (filter (lambda (y) (not (same? x y))) lst))
(define (remove pred lst) (filter (lambda (x) (not (pred x))) lst))
(define (partition pred lst)
  (let loop ((l lst) (in ()) (out ()))
    (cond ((null? l) (values (reverse! in) (reverse! out)))
          ((pred (car l)) (loop (cdr l) (cons (car l) in) out))
          (else (loop (cdr l) in (cons (car l) out))))))
(define (filter-map f lst . lsts)
  (filter identity (apply map f lst lsts)))
(define (append-map f lst . lsts) (apply append (apply map f lst lsts)))
(define (find pred lst)
  (let ((tail (find-tail pred lst))) (and tail (car tail))))
(define (find-tail pred lst)
  (cond ((not (pair? lst)) #f) ((pred (car lst)) lst) (else (find-tail pred (cdr lst)))))
(define (list-index pred lst)
  (let loop ((l lst) (i 0))
    (cond ((not (pair? l)) #f) ((pred (car l)) i) (else (loop (cdr l) (+ i 1))))))
(define (sort lst less?)
  (define (merge a b)
    (cond ((null? a) b) ((null? b) a)
          ((less? (car b) (car a)) (cons (car b) (merge a (cdr b))))
          (else (cons (car a) (merge (cdr a) b)))))
  (define (msort l n)
    (if (<= n 1) (if (= n 1) (list (car l)) ())
        (let ((h (div0 n 2)))
          (merge (msort l h) (msort (list-tail l h) (- n h))))))
  (if (vector? lst)
      (list->vector (msort (vector->list lst) (length lst)))
      (msort lst (length lst))))

; vectors ------------------------------------------------------------------

(define (vector-ref v k) (aref v k))
(define (vector-set! v k x) (aset! v k x))
(define (vector-length v) (if (vector? v) (length v) (raise (list 'type-error 'vector-length 'vector v))))
(define (make-vector n (fill #f)) (vector.alloc n fill))
(define %vector->list vector->list)
(define (vector->list v (start 0) (end #f))
  (let ((end (or end (length v))))
    (let loop ((i (- end 1)) (acc ()))
      (if (< i start) acc (loop (- i 1) (cons (aref v i) acc))))))
(define (vector-fill! v x (start 0) (end #f))
  (let ((end (or end (length v))))
    (do ((i start (+ i 1))) ((>= i end) v) (aset! v i x))))
(define (vector-copy v (start 0) (end #f)) (list->vector (vector->list v start end)))
(define (vector-copy! to at from (start 0) (end #f))
  (let* ((end (or end (length from)))
         (items (vector->list from start end)))
    (if (< at start)
        (do ((i 0 (+ i 1)) (l items (cdr l))) ((null? l)) (aset! to (+ at i) (car l)))
        (do ((i (- (length items) 1) (- i 1))) ((< i 0)) (aset! to (+ at i) (list-ref items i))))
    to))
(define (vector-append . vs) (list->vector (apply append (map vector->list vs))))
(define (vector-map f v . vs)
  (list->vector (apply map f (vector->list v) (map vector->list vs))))
(define (vector-for-each f v . vs)
  (apply for-each f (vector->list v) (map vector->list vs)))

; bytevectors (femtolisp uint8 arrays) ---------------------------------------

(define (bytevector? x) (equal? (typeof x) '(array uint8)))
(define (bytevector . bytes) (apply array 'uint8 bytes))
(define (make-bytevector n (fill 0)) (apply array 'uint8 (make-list n fill)))
(define (bytevector-u8-ref bv k) (aref bv k))
(define (bytevector-u8-set! bv k b) (aset! bv k b))
(define (bytevector-length bv) (length bv))
(define (bytevector-copy bv (start 0) (end #f))
  (let ((end (or end (length bv))))
    (apply bytevector (map (lambda (i) (aref bv i)) (iota (- end start) start)))))
(define (bytevector-append . bvs)
  (apply bytevector (apply append (map (lambda (bv) (map (lambda (i) (aref bv i))
                                                      (iota (length bv))))
                                         bvs))))

; ports ----------------------------------------------------------------------

(define (current-output-port) *output-stream*)
(define (current-input-port) *input-stream*)
(define (current-error-port) *error-stream*)
(define (port? x) (iostream? x))
(define (input-port? x) (iostream? x))
(define (output-port? x) (iostream? x))
(define (textual-port? x) (iostream? x))
(define (binary-port? x) (iostream? x))
(define (input-port-open? p) #t)
(define (output-port-open? p) #t)
(define (close-port p) (io.close p))
(define (close-input-port p) (io.close p))
(define (close-output-port p) (io.close p))
(define (flush-output-port (p *output-stream*)) (io.flush p))
(define (call-with-port p proc) (prog1 (proc p) (io.close p)))

(define (display x (port *output-stream*))
  (with-bindings ((*print-readably* #f)) (write x port))
  (void))
(define (write-shared x (port *output-stream*)) (write x port) (void))
(define (write-simple x (port *output-stream*)) (write x port) (void))
(define (write-string s (port *output-stream*) (start 0) (end #f))
  (io.write port (if (or (> start 0) end) (substring s start end) s))
  (void))
(define (write-char c (port *output-stream*)) (io.write port (string c)) (void))
(define (write-u8 b (port *output-stream*)) (io.write port (bytevector b)) (void))

(define (read-char (port *input-stream*)) (io.getc port))
(define (peek-char (port *input-stream*)) (io.peekc port))
(define (char-ready? (port *input-stream*)) #t)
(define (read-line (port *input-stream*))
  (let ((line (io.readline port)))
    (cond ((eof-object? line) line)
          ((and (equal? line "") (io.eof? port)) (eof-object))
          ((string-suffix? "\n" line) (string.sub line 0 (- (sizeof line) 1)))
          (else line))))
(define (read-string k (port *input-stream*))
  (let loop ((k k) (acc ()))
    (let ((c (if (> k 0) (io.getc port) (eof-object))))
      (if (eof-object? c)
          (if (and (null? acc) (> k 0)) c (list->string (reverse! acc)))
          (loop (- k 1) (cons c acc))))))

(define (open-input-string s)
  (let ((b (buffer))) (io.write b s) (io.seek b 0) b))
(define (open-output-string) (buffer))
(define (get-output-string port)
  (let ((s (io.tostring! port))) (io.write port s) s))
(define (with-output-to-string thunk)
  (let ((b (buffer))) (with-output-to b (thunk)) (io.tostring! b)))
(define (call-with-output-string proc)
  (let ((b (buffer))) (proc b) (io.tostring! b)))
(define (%write-string x)
  (let ((b (buffer))) (write x b) (io.tostring! b)))

(define (open-input-file name) (file name :read))
(define (open-output-file name) (file name :write :create :truncate))
(define (call-with-input-file name proc) (call-with-port (open-input-file name) proc))
(define (call-with-output-file name proc) (call-with-port (open-output-file name) proc))
(define (with-input-from-file name thunk)
  (let ((p (open-input-file name)))
    (prog1 (with-input-from p (thunk)) (io.close p))))
(define (with-output-to-file name thunk)
  (let ((p (open-output-file name)))
    (prog1 (with-output-to p (thunk)) (io.close p))))
(define (file-exists? name) (path.exists? name))
